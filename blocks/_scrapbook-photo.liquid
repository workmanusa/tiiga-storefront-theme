{% doc %}
  One snapshot in the founder scrapbook: a photo pinned at a slight angle with
  an optional caption underneath, the way a print would sit in an album.

  @example
  {% content_for 'block', type: '_scrapbook-photo', id: 'snap-1' %}
{% enddoc %}

<figure
  class="scrapbook-photo"
  style="
    --snap-rotation: {{ block.settings.rotation }}deg;
    --snap-span: {{ block.settings.span }};
    --snap-lift: {{ block.settings.lift }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image -%}
    {{
      block.settings.image
      | image_url: width: 900
      | image_tag: class: 'scrapbook-photo__image', loading: 'lazy', alt: block.settings.caption
    }}
  {%- else -%}
    <span class="scrapbook-photo__image scrapbook-photo__image--empty"></span>
  {%- endif -%}

  {%- if block.settings.caption != blank -%}
    <figcaption class="scrapbook-photo__caption">{{ block.settings.caption }}</figcaption>
  {%- endif -%}
</figure>

{% stylesheet %}
  .scrapbook-photo {
    grid-column: span var(--snap-span, 6);
    margin: 0;
    /* Lift staggers the row so prints overlap instead of sitting on a line */
    transform: translateY(var(--snap-lift, 0px)) rotate(var(--snap-rotation, 0deg));
    background-color: #fff;
    padding: 0.625rem 0.625rem 0;
    border-radius: 4px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  /* Prints keep their own proportions — a square, a wide landscape, and a
     portrait sitting together is what makes a wall of photos read as one. */
  .scrapbook-photo__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  .scrapbook-photo__image--empty {
    aspect-ratio: 4 / 3;
    background-color: rgb(var(--color-foreground-rgb) / 0.08);
  }

  .scrapbook-photo__caption {
    padding: 0.75rem 0.25rem 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    text-align: center;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  @media screen and (max-width: 749px) {
    .scrapbook-photo {
      grid-column: span 12;
      /* Stacked prints read better upright than tilted */
      transform: rotate(calc(var(--snap-rotation, 0deg) * 0.5));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.scrapbook_photo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:settings.caption"
    },
    {
      "type": "range",
      "id": "span",
      "label": "t:settings.width",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "rotation",
      "label": "t:settings.rotation",
      "min": -8,
      "max": 8,
      "step": 1,
      "default": -2
    },
    {
      "type": "range",
      "id": "lift",
      "label": "t:settings.vertical_position",
      "min": -60,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.scrapbook_photo"
    }
  ]
}
{% endschema %}
