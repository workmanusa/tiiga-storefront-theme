{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant

  # The reference shows the flavor as the headline. Prefer the selected
  # Flavor option value, falling back to the variant then product title.
  assign headline = blank
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'flavor'
      assign headline = option.selected_value
    endif
  endfor
  if headline == blank
    assign headline = variant.title | default: product.title
  endif
  if headline == 'Default Title'
    assign headline = product.title
  endif
-%}

<div class="pdp-header" {{ block.shopify_attributes }}>
  {%- if block.settings.eyebrow != blank -%}
    <span class="pdp-header__eyebrow">{{ block.settings.eyebrow }}</span>
  {%- endif -%}

  <h1 class="pdp-header__title">{{ headline }}</h1>

  {%- if block.settings.show_rating and block.settings.rating != blank -%}
    <div class="pdp-header__rating">
      <span class="pdp-header__stars" aria-hidden="true">★★★★★</span>
      <span class="pdp-header__rating-value">
        {{- block.settings.rating -}}
        {%- if block.settings.review_count != blank %} ({{ block.settings.review_count }}){% endif -%}
      </span>
    </div>
  {%- endif -%}

  {%- if block.settings.eligibility != blank -%}
    <p class="pdp-header__eligibility">
      <span class="pdp-header__check" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="10" cy="10" r="8.5" />
          <path d="M6 10.2l2.7 2.6L14 7.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      {{ block.settings.eligibility }}
      {%- if block.settings.eligibility_link != blank and block.settings.eligibility_link_label != blank -%}
        <a href="{{ block.settings.eligibility_link }}">{{ block.settings.eligibility_link_label }}</a>
      {%- endif -%}
    </p>
  {%- endif -%}

  {%- if block.settings.description != blank -%}
    <div class="pdp-header__description">{{ block.settings.description }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .pdp-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .pdp-header__eyebrow {
    background-color: #fff;
    border-radius: 100px;
    padding: 0.375rem 1rem;
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pdp-header__title {
    margin: 0;
    font-size: clamp(2.5rem, 4.4vw, 4rem);
    line-height: 1.02;
  }

  .pdp-header__rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .pdp-header__stars {
    letter-spacing: 0.12em;
    color: var(--flavor-color, var(--color-foreground));
  }

  .pdp-header__eligibility {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4375rem;
    margin: 0;
    font-size: 0.9375rem;
  }

  .pdp-header__check {
    display: inline-flex;
    width: 1.125rem;
    color: #2e7d5b;
  }

  .pdp-header__check svg {
    width: 100%;
    height: auto;
  }

  .pdp-header__eligibility a {
    color: currentcolor;
    text-underline-offset: 0.2em;
  }

  .pdp-header__description {
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 34rem;
  }

  .pdp-header__description p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pdp_header",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:settings.show_rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating",
      "label": "t:settings.rating"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "t:settings.text"
    },
    {
      "type": "text",
      "id": "eligibility",
      "label": "t:settings.title"
    },
    {
      "type": "text",
      "id": "eligibility_link_label",
      "label": "t:settings.label"
    },
    {
      "type": "url",
      "id": "eligibility_link",
      "label": "t:settings.link"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.text"
    }
  ],
  "presets": [
    {
      "name": "t:names.pdp_header"
    }
  ]
}
{% endschema %}
