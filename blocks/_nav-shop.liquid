{%- doc -%}
  Renders the "Shop" navigation item for the nav menu (blocks/_nav-menu.liquid).

  Renders as a pill in the desktop header that opens a mega panel (browse
  sidebar + product grid + promo banner), and as an accordion row in the
  mobile drawer (browse pills + product grid + promo banner).

  Browse tabs are provided by `_nav-shop-tab` child blocks.

  @example
  {% content_for 'blocks' %}
{%- enddoc -%}

<details
  class="nav-item nav-item--shop"
  name="nav-menu-item"
  {% if block.settings.open_by_default %}
    data-default-open
  {% endif %}
  {{ block.shopify_attributes }}
>
  <summary class="nav-item__row">
    <span>{{ block.settings.label }}</span>
    <span class="svg-wrapper nav-item__caret">
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </span>
  </summary>
  <div class="nav-item__panel">
    <div class="nav-item__panel-inner nav-shop">
      <nav-shop-tabs class="nav-shop-tabs">
        {% if block.settings.browse_label != blank %}
          <p class="nav-menu__eyebrow nav-shop-tabs__eyebrow">{{ block.settings.browse_label }}</p>
        {% endif %}
        {% content_for 'blocks' %}
      </nav-shop-tabs>

      {% if block.settings.banner_heading != blank or block.settings.banner_image != blank %}
        {% capture promo_content %}
          {% if block.settings.banner_image != blank %}
            {{
              block.settings.banner_image
              | image_url: width: 800
              | image_tag: class: 'nav-promo__image', widths: '400, 600, 800', sizes: '(min-width: 750px) 300px, 90vw', loading: 'lazy'
            }}
          {% endif %}
          <span class="nav-promo__content">
            {% if block.settings.banner_heading != blank %}
              <span class="nav-promo__heading">{{ block.settings.banner_heading }}</span>
            {% endif %}
            {% if block.settings.banner_button_label != blank %}
              <span class="nav-promo__cta">{{ block.settings.banner_button_label }}</span>
            {% endif %}
          </span>
        {% endcapture %}
        {% if block.settings.banner_link != blank %}
          <a
            href="{{ block.settings.banner_link }}"
            class="nav-promo"
            style="--nav-promo-text: {{ block.settings.banner_text_color | default: '#ffffff' }};"
          >
            {{ promo_content }}
          </a>
        {% else %}
          <div
            class="nav-promo"
            style="--nav-promo-text: {{ block.settings.banner_text_color | default: '#ffffff' }};"
          >
            {{ promo_content }}
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</details>

{% stylesheet %}
  /* Drawer mode: tabs then promo, stacked */
  .nav-shop-tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .nav-shop-tabs__eyebrow {
    width: 100%;
  }

  .nav-promo {
    position: relative;
    display: block;
    overflow: hidden;
    margin-block-start: var(--margin-lg);
    border-radius: 14px;
    aspect-ratio: 16 / 6;
    background-color: var(--nav-card-background);
    text-decoration: none;
  }

  .nav-promo__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .nav-promo__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--padding-lg);
  }

  .nav-promo__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 1.375rem;
    line-height: 1.15;
    max-width: 70%;
    color: var(--nav-promo-text);
  }

  .nav-promo__cta {
    display: inline-block;
    padding: var(--padding-2xs) var(--padding-md);
    border-radius: 100px;
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  .nav-promo:hover .nav-promo__cta {
    opacity: 0.85;
  }

  /* Menu mode (desktop): sidebar tabs + grid + promo column */
  @media screen and (min-width: 750px) {
    #header-component:not([data-menu-style='drawer']) {
      .nav-shop {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        column-gap: var(--gap-2xl);
        align-items: stretch;
      }

      .nav-shop-tabs {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        grid-template-rows: repeat(9, max-content) 1fr;
        column-gap: var(--gap-2xl);
        align-items: start;
      }

      .nav-shop-tabs__eyebrow {
        grid-column: 1;
        width: auto;
      }

      .nav-promo {
        margin-block-start: 0;
        aspect-ratio: auto;
        min-height: 240px;
        align-self: stretch;
      }

      .nav-promo__heading {
        font-size: 1.5rem;
        max-width: 60%;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.nav_shop",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "browse_label",
      "label": "t:settings.browse_label",
      "default": "Browse"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "t:settings.open_by_default",
      "info": "t:info.nav_open_by_default",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.promo_banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "t:settings.heading"
    },
    {
      "type": "text",
      "id": "banner_button_label",
      "label": "t:settings.button_label"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "t:settings.link"
    },
    {
      "type": "color",
      "id": "banner_text_color",
      "label": "t:settings.text_color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "_nav-shop-tab"
    }
  ],
  "presets": [
    {
      "name": "t:names.nav_shop"
    }
  ]
}
{% endschema %}
