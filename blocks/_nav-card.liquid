{%- doc -%}
  Renders a content card in a nav menu section (blocks/_nav-submenu.liquid):
  a soft card with a thumbnail, title and short description.

  @example
  {% content_for 'blocks' %}
{%- enddoc -%}

{% capture card_content %}
  <span class="nav-card__media">
    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 200
        | image_tag: class: 'nav-card__image', widths: '100, 200', sizes: '72px', loading: 'lazy'
      }}
    {% endif %}
  </span>
  <span class="nav-card__text">
    {% if block.settings.title != blank %}
      <span class="nav-card__title">{{ block.settings.title }}</span>
    {% endif %}
    {% if block.settings.description != blank %}
      <span class="nav-card__description">{{ block.settings.description }}</span>
    {% endif %}
  </span>
{% endcapture %}

{% if block.settings.link != blank %}
  <a
    href="{{ block.settings.link }}"
    class="nav-card"
    {{ block.shopify_attributes }}
  >
    {{ card_content }}
  </a>
{% else %}
  <div
    class="nav-card"
    {{ block.shopify_attributes }}
  >
    {{ card_content }}
  </div>
{% endif %}

{% stylesheet %}
  .nav-card {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    padding: var(--padding-2xs) var(--padding-lg) var(--padding-2xs) var(--padding-2xs);
    border-radius: 10px;
    background-color: var(--nav-card-background);
    text-decoration: none;
    color: inherit;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  a.nav-card:hover {
    opacity: 0.8;
  }

  .nav-card__media {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 10px;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .nav-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .nav-card__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--gap-3xs);
    min-width: 0;
  }

  .nav-card__title {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-foreground);
  }

  .nav-card__description {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.nav_card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.nav_card"
    }
  ]
}
{% endschema %}
