{% doc %}
  One floating photo in a statement collage. Position, size, tilt, and drift
  are per-photo settings so the scatter can be composed in the editor rather
  than hardcoded.

  Photos are decorative: the parent marks the whole cluster aria-hidden, so no
  alt text is carried here.

  @example
  {% content_for 'block', type: '_collage-photo', id: 'photo-1' %}
{% enddoc %}

<div
  class="collage-photo"
  style="
    --collage-x: {{ block.settings.x }}%;
    --collage-y: {{ block.settings.y }}%;
    --collage-w: {{ block.settings.width }}%;
    --collage-r: {{ block.settings.rotation }}deg;
    --collage-speed: {{ block.settings.speed }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image -%}
    {{
      block.settings.image
      | image_url: width: 720
      | image_tag: class: 'collage-photo__image', loading: 'lazy', alt: ''
    }}
  {%- else -%}
    <span class="collage-photo__image collage-photo__image--empty"></span>
  {%- endif -%}
</div>

{% stylesheet %}
  .collage-photo {
    position: absolute;
    inset-block-start: var(--collage-y, 0%);
    inset-inline-start: var(--collage-x, 0%);
    width: var(--collage-w, 16%);
    /* --collage-shift is written by the parent on scroll; the tilt stays put */
    transform: translate3d(0, var(--collage-shift, 0px), 0) rotate(var(--collage-r, 0deg));
    will-change: transform;
  }

  .collage-photo__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 10px;
  }

  .collage-photo__image--empty {
    background-color: rgb(var(--color-foreground-rgb) / 0.08);
  }

  /* Narrow screens have no room for a scatter beside the words, so the
     cluster collapses to four corner prints and the rest step aside. Scoped
     to the scattered layout — split places its photos in a grid. */
  @media screen and (max-width: 749px) {
    /* Drift is dropped here: it moves a print up to 80px, which is enough to
       carry a corner into the words when the margins are this tight. The tilt
       is kept — only the translate goes. */
    .collage-photo {
      transform: rotate(var(--collage-r, 0deg));
    }

    .statement--scatter .collage-photo {
      /* Capped in px as well as %, so a print can never grow past the band
         of padding the stage keeps clear above and below the words. */
      width: min(26%, 150px);
    }

    .statement--scatter .collage-photo:nth-child(n + 5) {
      display: none;
    }

    .statement--scatter .collage-photo:nth-child(1) {
      inset-inline-start: -5%;
      inset-block-start: 0;
    }

    .statement--scatter .collage-photo:nth-child(2) {
      inset-inline-start: 79%;
      inset-block-start: 0;
    }

    /* Anchored to the bottom edge rather than a percentage, so the print
       lands in the padding whatever height the statement runs to. */
    .statement--scatter .collage-photo:nth-child(3) {
      inset-inline-start: -6%;
      inset-block-start: auto;
      inset-block-end: 0;
    }

    .statement--scatter .collage-photo:nth-child(4) {
      inset-inline-start: 80%;
      inset-block-start: auto;
      inset-block-end: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collage_photo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "range",
      "id": "x",
      "label": "t:settings.horizontal_position",
      "min": -10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 4
    },
    {
      "type": "range",
      "id": "y",
      "label": "t:settings.vertical_position",
      "min": -10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:settings.width",
      "min": 6,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 14
    },
    {
      "type": "range",
      "id": "rotation",
      "label": "t:settings.rotation",
      "min": -12,
      "max": 12,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.speed",
      "min": -10,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:names.collage_photo"
    }
  ]
}
{% endschema %}
