{%- doc -%}
  Renders the Tiiga navigation menu, replacing Horizon's header menu, mobile
  drawer and navigation bar. One DOM tree serves two presentations:

  - Drawer mode (small screens / touch devices, `data-menu-style='drawer'`):
    a hamburger opens a slide-out panel with a "Menu" header, accordion rows
    and an account footer.
  - Menu mode (desktop): items render inline next to the logo and expandable
    items open full-width mega panels below the header row.

  Menu rows are provided by child blocks: `_nav-shop` (browse tabs + product
  grid + promo banner), `_nav-submenu` (content cards + featured articles)
  and `_nav-link` (plain links).

  @example
  {% content_for 'block', type: '_nav-menu', id: 'nav-menu' %}
{%- enddoc -%}

<script
  src="{{ 'nav-menu.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<nav-menu
  class="nav-menu"
  style="--nav-card-background: {{ block.settings.card_background | default: '#f2f0ec' }};"
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="button-unstyled nav-menu__hamburger"
    aria-expanded="false"
    aria-controls="NavMenuPanel-{{ block.id }}"
    aria-label="{{ 'accessibility.menu' | t }}"
    ref="hamburger"
    on:click="/toggle"
  >
    <span class="svg-wrapper">
      {{- 'icon-menu.svg' | inline_asset_content -}}
    </span>
  </button>

  <div
    class="nav-menu__panel"
    id="NavMenuPanel-{{ block.id }}"
    ref="panel"
  >
    <div class="nav-menu__drawer-header">
      <p class="nav-menu__drawer-title">{{ 'accessibility.menu' | t }}</p>
      <button
        class="button-unstyled nav-menu__drawer-close focus-inset"
        type="button"
        aria-label="{{ 'actions.close' | t }}"
        on:click="/close"
      >
        <span class="svg-wrapper">
          {{- 'icon-close-menu.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>

    <nav
      class="nav-menu__nav"
      aria-label="{{ 'accessibility.header_navigation_label' | t }}"
    >
      {% content_for 'blocks' %}
    </nav>

    <div class="nav-menu__drawer-footer">
      {% if shop.customer_accounts_enabled %}
        <a
          href="{{ routes.account_url }}"
          class="nav-menu__utility"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="17"
            viewBox="0 0 15 17"
            fill="none"
            aria-hidden="true"
            class="nav-menu__utility-icon"
          >
            <path
              stroke="currentColor"
              stroke-linejoin="round"
              stroke-width="var(--icon-stroke-width)"
              d="M10.375 3.813a3.063 3.063 0 1 1-6.125 0 3.063 3.063 0 0 1 6.125 0ZM7.313 9.5c-3.667 0-6.24 2.691-6.563 6.125h13.125C13.552 12.191 10.979 9.5 7.312 9.5Z"
            />
          </svg>
          {{ 'content.account_title' | t }}
        </a>
      {% endif %}
      {% # Same destination as the header's help icon, so the drawer covers %}
      {% # the full set of header actions. %}
      <a
        href="{{ pages['faq'].url | default: '/pages/faq' }}"
        class="nav-menu__utility"
      >
        <span class="svg-wrapper nav-menu__utility-icon" aria-hidden="true">
          {{- 'icon-question.svg' | inline_asset_content -}}
        </span>
        {{ 'content.faq' | t }}
      </a>
    </div>
  </div>

  <div
    class="nav-menu__backdrop"
    on:click="/close"
  ></div>
</nav-menu>

{% stylesheet %}
  /* ================================
     * Drawer mode (default; small screens and touch devices)
     * ================================ */
  .nav-menu {
    display: flex;
    align-items: center;
    height: 100%;

    /* Only takes effect on the mobile header grid */
    grid-area: leftA;
  }

  .nav-menu__hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
    color: var(--color-foreground);
    cursor: pointer;
  }

  .nav-menu__hamburger .svg-wrapper {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }

  .nav-menu__panel {
    /* Narrower than Horizon's default drawer, per the reference (89vw, 400px cap) */
    --drawer-width: 89vw;
    --drawer-max-width: 400px;

    /* Soft warm hairline derived from the scheme's charcoal foreground —
       the stock var(--color-border) reads as harsh black lines here */
    --nav-hairline: rgb(var(--color-foreground-rgb) / 0.08);

    position: fixed;
    top: 0;
    left: 0;
    height: var(--drawer-height);
    width: var(--drawer-width);
    max-width: var(--drawer-max-width);
    z-index: var(--layer-menu-drawer);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background-color: var(--color-background);
    /* Rounded trailing edge, same 20px radius language as the search sheet
       and PDP tiles. The overflow scroll box clips the sticky bars to it. */
    border-start-end-radius: 20px;
    border-end-end-radius: 20px;
    box-shadow: var(--shadow-popover);
    transform: translateX(-100%);
    visibility: hidden;
    transition: transform var(--drawer-animation-speed) ease, visibility var(--drawer-animation-speed) ease;
  }

  .nav-menu--open .nav-menu__panel {
    transform: translateX(0);
    visibility: visible;
  }

  /* The header's `contain: layout` makes it the containing block for the
     fixed drawer, pushing it below the announcement bar and cutting off the
     footer. Relax containment while open (same fix as Horizon's own drawer)
     so the panel spans the full viewport height. */
  .header:has(.nav-menu--open) {
    contain: style;
  }

  .nav-menu__backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--layer-overlay);
    backdrop-filter: brightness(0.75);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--drawer-animation-speed) ease;
  }

  .nav-menu--open .nav-menu__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-menu__drawer-header {
    position: sticky;
    top: 0;
    z-index: var(--layer-raised);
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding-block: var(--padding-2xs);
    padding-inline: var(--padding-xl) var(--padding-xs);
    background-color: var(--color-background);
    border-block-end: var(--style-border-width) solid var(--nav-hairline);
    flex-shrink: 0;
  }

  .nav-menu__drawer-title {
    /* Same kicker voice as the PDP's FLAVOR / VARIETY PACKS headings */
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  .nav-menu__drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
    color: var(--color-foreground);
    cursor: pointer;
  }

  .nav-menu__drawer-close .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .nav-menu__nav {
    flex: 1 0 auto;
    padding-block: var(--padding-xs) var(--padding-lg);
    padding-inline: var(--padding-sm);
  }

  .nav-menu__drawer-footer {
    position: sticky;
    bottom: 0;
    z-index: var(--layer-raised);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin-block-start: auto;
    background-color: var(--color-background);
    border-block-start: var(--style-border-width) solid var(--nav-hairline);
    flex-shrink: 0;
  }

  .nav-menu__utility {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-sm);
    min-height: var(--minimum-touch-target);
    padding-block: var(--padding-lg);
    padding-inline: var(--padding-sm);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .nav-menu__utility + .nav-menu__utility {
    border-inline-start: var(--style-border-width) solid var(--nav-hairline);
  }

  .nav-menu__utility-icon {
    flex-shrink: 0;
    width: auto;
    height: 1.0625rem;
    color: var(--color-foreground);
  }

  .nav-menu__utility-icon svg {
    width: auto;
    height: 100%;
  }

  /* ================================
     * Menu items (shared by child blocks)
     * ================================ */
  .nav-item__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    width: 100%;
    padding-block: 0.875rem;
    padding-inline: var(--padding-sm);
    /* Drawer rows speak in the site's serif display voice; desktop menu
       mode resets this to the body font below. */
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 1.625rem;
    line-height: 1.15;
    color: var(--color-foreground);
    text-decoration: none;
    text-align: left;
    cursor: pointer;
    list-style: none;
    border-radius: 0.625rem;
  }

  /* Drawer rows highlight softly instead of relying on divider lines */
  .nav-item__row:hover,
  .nav-item__row:active {
    background-color: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .nav-item__row::marker,
  .nav-item__row::-webkit-details-marker {
    display: none;
    content: '';
  }

  .nav-item__caret {
    display: flex;
    flex-shrink: 0;
    width: var(--icon-size-2xs, 0.625rem);
    height: var(--icon-size-2xs, 0.625rem);
    color: var(--color-foreground-muted);
  }

  .nav-item__caret svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .nav-item[open] > .nav-item__row .nav-item__caret svg {
    transform: rotate(0deg);
  }

  /* Animate the accordion body open/close. `interpolate-size` lets modern
     browsers transition to block-size: auto; others just snap open. */
  .nav-item {
    interpolate-size: allow-keywords;
  }

  .nav-item::details-content {
    block-size: 0;
    overflow-y: clip;
    transition: content-visibility var(--animation-speed) allow-discrete,
      block-size var(--animation-speed) var(--animation-easing);
  }

  .nav-item[open]::details-content {
    block-size: auto;
  }

  .nav-item__panel-inner {
    padding-block: var(--padding-3xs) var(--padding-xl);
    padding-inline: var(--padding-xl);
  }

  .nav-menu__eyebrow {
    margin-block: 0 var(--margin-sm);
    font-family: var(--font-body--family);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  /* Rows glide in one after another once the panel lands. Backwards fill
     keeps them invisible through the delay; the class toggle re-runs the
     animation on every open. */
  @media (prefers-reduced-motion: no-preference) {
    .nav-menu--open .nav-menu__nav > .nav-item,
    .nav-menu--open .nav-menu__drawer-footer {
      animation: nav-menu-row-in 0.35s var(--animation-easing) backwards;
      animation-delay: calc(0.12s + 0.045s * var(--nav-row-index, 6));
    }

    .nav-menu__nav > .nav-item:nth-child(1) { --nav-row-index: 0; }
    .nav-menu__nav > .nav-item:nth-child(2) { --nav-row-index: 1; }
    .nav-menu__nav > .nav-item:nth-child(3) { --nav-row-index: 2; }
    .nav-menu__nav > .nav-item:nth-child(4) { --nav-row-index: 3; }
    .nav-menu__nav > .nav-item:nth-child(5) { --nav-row-index: 4; }
    .nav-menu__nav > .nav-item:nth-child(6) { --nav-row-index: 5; }
  }

  @keyframes nav-menu-row-in {
    from {
      opacity: 0;
      transform: translateX(-0.5rem);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* ================================
     * Menu mode (desktop, fine pointer)
     * ================================ */
  @media screen and (min-width: 750px) {
    #header-component:not([data-menu-style='drawer']) {
      .nav-menu__hamburger,
      .nav-menu__drawer-header,
      .nav-menu__drawer-footer,
      .nav-menu__backdrop {
        display: none;
      }

      .nav-menu__panel {
        /* visibility would otherwise inherit from the hidden drawer state */
        display: contents;
        visibility: visible;
      }

      .nav-menu__nav {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        padding-block: 0;
        padding-inline: 0;
      }

      .nav-item {
        border-block-end: none;
        display: flex;
        align-items: center;
      }

      .nav-item__row {
        width: auto;
        padding-block: var(--padding-2xs);
        padding-inline: 0;
        /* Back to the inline body voice — the serif display treatment is
           drawer-only. */
        font-family: var(--font-body--family);
        font-style: normal;
        font-weight: 500;
        font-size: 0.875rem;
        line-height: normal;
      }

      /* Inline links keep the underline treatment, not the drawer highlight */
      .nav-item__row:hover,
      .nav-item__row:active {
        background-color: transparent;
      }

      .nav-item__caret {
        display: none;
      }

      /* Text items get the reference's animated underline on hover/open */
      .nav-item:not(.nav-item--shop, .nav-item--pill) > .nav-item__row {
        position: relative;
      }

      .nav-item:not(.nav-item--shop, .nav-item--pill) > .nav-item__row::after {
        content: '';
        position: absolute;
        inset-inline: 0;
        inset-block-end: 0;
        height: 1px;
        background-color: currentcolor;
        transform: scaleX(0);
        transform-origin: 100% 50%;
        transition: transform 0.3s var(--animation-easing);
      }

      .nav-item:not(.nav-item--shop, .nav-item--pill) > .nav-item__row:hover::after,
      .nav-item[open]:not(.nav-item--shop, .nav-item--pill) > .nav-item__row::after {
        transform: scaleX(1);
        transform-origin: 0 50%;
      }

      /* The Shop item renders as a solid pill */
      :is(.nav-item--shop, .nav-item--pill) > .nav-item__row {
        background-color: var(--color-foreground);
        color: var(--color-background);
        border-radius: 100px;
        padding-block: var(--padding-2xs);
        padding-inline: 1rem;
        min-height: 2rem;
        transition: background-color var(--animation-speed) var(--animation-easing);
      }

      :is(.nav-item--shop, .nav-item--pill) > .nav-item__row:hover {
        background-color: rgb(var(--color-foreground-rgb) / 0.85);
        color: var(--color-background);
      }

      /* Full-width mega panel below the header row */
      .nav-item__panel {
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        z-index: var(--layer-header-menu);
        background-color: var(--color-background);
        border-block-start: var(--style-border-width) solid var(--color-border);
        border-block-end: var(--style-border-width) solid var(--color-border);
        box-shadow: var(--shadow-popover);
        max-height: calc(90dvh - var(--header-height));
        overflow-y: auto;
      }

      .nav-item__panel-inner {
        max-width: var(--page-width);
        margin-inline: auto;
        padding-block: var(--padding-2xl) var(--padding-3xl);
        padding-inline: var(--page-margin);
      }
    }
  }

  /* Elevate the header row while a mega panel is open so it overlays
     the page content below. */
  .header__row:has(.nav-item[open]) {
    z-index: var(--layer-heightened);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.nav_menu",
  "tag": null,
  "settings": [
    {
      "type": "color",
      "id": "card_background",
      "label": "t:settings.card_background",
      "default": "#f2f0ec"
    }
  ],
  "blocks": [
    {
      "type": "_nav-shop"
    },
    {
      "type": "_nav-submenu"
    },
    {
      "type": "_nav-link"
    }
  ]
}
{% endschema %}
