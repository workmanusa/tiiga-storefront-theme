{% doc %}
  One point on the milestone timeline: a year, a headline, supporting detail,
  and up to three partner or retailer logos.

  The rail and its dots are drawn by the parent section, so this block only
  renders the content beside them.

  @example
  {% content_for 'block', type: '_milestone', id: 'milestone-2019' %}
{% enddoc %}

<li
  class="milestone"
  {{ block.shopify_attributes }}
>
  <span class="milestone__dot" aria-hidden="true"></span>

  {%- if block.settings.year != blank -%}
    <span class="milestone__year">{{ block.settings.year }}</span>
  {%- endif -%}

  <div class="milestone__body">
    {%- if block.settings.title != blank -%}
      <h3 class="milestone__title">{{ block.settings.title }}</h3>
    {%- endif -%}

    {%- if block.settings.text != blank -%}
      <div class="milestone__text">{{ block.settings.text }}</div>
    {%- endif -%}

    {%- liquid
      assign has_logos = false
      for i in (1..3)
        assign logo_key = 'logo_' | append: i
        if block.settings[logo_key]
          assign has_logos = true
        endif
      endfor
    -%}
    {%- if has_logos -%}
      <div class="milestone__logos">
        {%- for i in (1..3) -%}
          {%- liquid
            assign logo_key = 'logo_' | append: i
            assign logo = block.settings[logo_key]
          -%}
          {%- if logo -%}
            {{
              logo
              | image_url: width: 240
              | image_tag: class: 'milestone__logo', loading: 'lazy', alt: ''
            }}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</li>

{% stylesheet %}
  .milestone {
    position: relative;
    display: grid;
    grid-template-columns: var(--timeline-year-width, 6rem) minmax(0, 1fr);
    align-items: baseline;
    gap: 0 1.5rem;
    padding-block-end: 2.25rem;
    /* Clear the rail by a fixed step, whatever inset the section sets */
    padding-inline-start: calc(var(--timeline-rail-inset, 2rem) + 1.25rem);
  }

  .milestone:last-child {
    padding-block-end: 0;
  }

  .milestone__dot {
    position: absolute;
    /* Centred on the rail, not on the milestone's own edge */
    inset-inline-start: var(--timeline-rail-inset, 2rem);
    inset-block-start: 0.4em;
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 50%;
    background-color: var(--timeline-accent);
    /* Punches through the rail so the line reads as passing behind it */
    box-shadow: 0 0 0 4px var(--timeline-surface);
    transform: translateX(-50%);
  }

  .milestone__year {
    font-family: var(--font-subheading--family);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--timeline-accent);
  }

  .milestone__title {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.35;
  }

  .milestone__text {
    margin-block-start: 0.375rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.75);
  }

  .milestone__text > :first-child {
    margin-block-start: 0;
  }

  .milestone__text > :last-child {
    margin-block-end: 0;
  }

  .milestone__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-block-start: 1rem;
  }

  .milestone__logo {
    width: auto;
    height: 1.5rem;
    object-fit: contain;
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .milestone {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
      padding-block-end: 1.75rem;
    }

    .milestone__year {
      font-size: 0.9375rem;
    }

    .milestone__logo {
      height: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.milestone",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "year",
      "label": "t:settings.year"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "image_picker",
      "id": "logo_1",
      "label": "t:settings.logo"
    },
    {
      "type": "image_picker",
      "id": "logo_2",
      "label": "t:settings.logo"
    },
    {
      "type": "image_picker",
      "id": "logo_3",
      "label": "t:settings.logo"
    }
  ],
  "presets": [
    {
      "name": "t:names.milestone"
    }
  ]
}
{% endschema %}
