{% doc %}
  Product result card for the search modal, in the same design grammar as the
  collections-rail cards: photo filling a warm rounded tile with a hover zoom,
  an uppercase type kicker, a clean title, and a quiet price.

  Titles follow the store's "TIIGA <line> | <descriptor>" naming: the
  descriptor becomes the card title and the line (minus the TIIGA prefix)
  becomes the kicker, so search results never show truncated pipe-titles.

  @param {object} product - The product to render

  @example
  {% render 'search-result-card', product: product %}
{% enddoc %}

{% liquid
  assign title_display = product.title
  assign type_display = product.type | default: product.vendor
  if product.title contains '|'
    assign title_parts = product.title | split: '|'
    assign title_display = title_parts | last | strip
    assign type_display = title_parts | first | remove_first: 'TIIGA' | strip
  endif
%}

<a
  class="search-card"
  href="{{ product.url }}"
>
  <div class="search-card__tile">
    {% if product.featured_image %}
      {{
        product.featured_image
        | image_url: width: 600
        | image_tag:
          class: 'search-card__image',
          loading: 'lazy',
          widths: '240, 360, 480, 600',
          sizes: '(min-width: 750px) 14rem, 44vw'
      }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'search-card__image search-card__image--placeholder' }}
    {% endif %}
  </div>
  <p class="search-card__type">{{ type_display }}</p>
  <p class="search-card__title">{{ title_display }}</p>
  <p class="search-card__price">{{ product.price | money }}</p>
</a>

{% stylesheet %}
  .search-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .search-card__tile {
    aspect-ratio: 0.93;
    border-radius: 8px;
    background-color: #f8f2ee;
    overflow: hidden;
  }

  .search-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.35s ease;
  }

  .search-card:hover .search-card__image {
    scale: 1.03;
  }

  .search-card__type {
    margin: 0.75rem 0 0;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .search-card__title {
    margin: 0.125rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .search-card__price {
    margin: 0.125rem 0 0;
    font-size: 0.8125rem;
    opacity: 0.7;
  }
{% endstylesheet %}
