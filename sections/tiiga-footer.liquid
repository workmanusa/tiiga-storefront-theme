{% comment %}
  Tiiga custom footer: one deep-teal environment replacing the stock banner +
  footer + utilities stack. Left, an email signup under a serif display
  heading; right, Shop / Learn / Follow columns; below, a hairline utility
  bar. New file so upstream Horizon merges stay clean.
{% endcomment %}

<div
  class="tiiga-footer"
  style="
    --tf-bg: {{ section.settings.background_color | default: '#1d5a6b' }};
    --tf-ink: {{ section.settings.text_color | default: '#efece7' }};
    --tf-ink-rgb: {{ section.settings.text_color.rgb | default: '239 236 231' }};
  "
>
  <div class="tiiga-footer__inner">
    <div class="tiiga-footer__top">
      <div class="tiiga-footer__brand">
        {%- if settings.logo != blank -%}
          <img
            class="tiiga-footer__logo"
            src="{{ settings.logo | image_url: width: 300 }}"
            width="150"
            height="{{ 150 | divided_by: settings.logo.aspect_ratio | round }}"
            loading="lazy"
            alt="{{ shop.name }}"
          >
        {%- endif -%}
        {%- if section.settings.eyebrow != blank -%}
          <p class="tiiga-footer__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tiiga-footer__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="tiiga-footer__blurb">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', class: 'tiiga-footer__signup-form' -%}
            <div class="tiiga-footer__signup">
              <label for="TiigaFooterEmail-{{ section.id }}" class="visually-hidden">
                {{ 'blocks.email_signup.label' | t }}
              </label>
              <input
                id="TiigaFooterEmail-{{ section.id }}"
                class="tiiga-footer__signup-input"
                type="email"
                name="contact[email]"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="TiigaFooterError-{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="TiigaFooterSuccess-{{ section.id }}"
                {% endif %}
              >
              <button class="tiiga-footer__signup-button" aria-label="{{ 'actions.sign_up' | t }}">
                <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                  {%- render 'icon', icon: 'arrow' -%}
                </svg>
              </button>
            </div>
            {%- if form.errors -%}
              <p id="TiigaFooterError-{{ section.id }}" class="tiiga-footer__signup-message" tabindex="-1">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p id="TiigaFooterSuccess-{{ section.id }}" class="tiiga-footer__signup-message" tabindex="-1">
                {{ 'blocks.email_signup.success' | t }}
              </p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>

      <nav class="tiiga-footer__cols" aria-label="{{ 'accessibility.footer_navigation' | t }}">
        <div class="tiiga-footer__col">
          {%- if section.settings.shop_heading != blank -%}
            <p class="tiiga-footer__col-heading">{{ section.settings.shop_heading }}</p>
          {%- endif -%}
          <ul class="tiiga-footer__links">
            {%- if section.settings.shop_collection != blank -%}
              {%- for product in section.settings.shop_collection.products limit: 6 -%}
                <li>
                  <a class="tiiga-footer__link" href="{{ product.url }}">
                    {{- product.title | split: '|' | last | strip | default: product.title -}}
                  </a>
                </li>
              {%- endfor -%}
              {%- if section.settings.shop_all_label != blank -%}
                <li>
                  <a class="tiiga-footer__link" href="{{ section.settings.shop_collection.url }}">
                    {{- section.settings.shop_all_label -}}
                  </a>
                </li>
              {%- endif -%}
            {%- else -%}
              {%- for link in section.settings.menu_1.links -%}
                <li><a class="tiiga-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>

        <div class="tiiga-footer__col">
          {%- if section.settings.learn_heading != blank -%}
            <p class="tiiga-footer__col-heading">{{ section.settings.learn_heading }}</p>
          {%- endif -%}
          <ul class="tiiga-footer__links">
            {%- for link in section.settings.menu_2.links -%}
              {%- liquid
                # Policy pages already live in the utility bar below — showing
                # them here too would double every legal link.
                if link.url contains '/policies/'
                  continue
                endif
              -%}
              <li><a class="tiiga-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="tiiga-footer__col">
          {%- if section.settings.social_heading != blank -%}
            <p class="tiiga-footer__col-heading">{{ section.settings.social_heading }}</p>
          {%- endif -%}
          <ul class="tiiga-footer__social">
            {%- liquid
              assign social_platforms = 'instagram,tiktok,facebook,youtube' | split: ','
            -%}
            {%- for platform in social_platforms -%}
              {%- liquid
                assign social_url = blank
                case platform
                  when 'instagram'
                    assign social_url = section.settings.instagram
                  when 'tiktok'
                    assign social_url = section.settings.tiktok
                  when 'facebook'
                    assign social_url = section.settings.facebook
                  when 'youtube'
                    assign social_url = section.settings.youtube
                endcase
              -%}
              {%- if social_url != blank -%}
                <li>
                  <a
                    class="tiiga-footer__social-link"
                    href="{{ social_url }}"
                    target="_blank"
                    rel="noopener"
                  >
                    <span class="visually-hidden">{{ platform | capitalize }}</span>
                    <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">
                      {%- render 'icon', icon: platform -%}
                    </svg>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </nav>
    </div>

    <div class="tiiga-footer__utilities">
      <p class="tiiga-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      <ul class="tiiga-footer__policies">
        {%- for policy in shop.policies -%}
          {%- if policy != blank and policy.title != blank -%}
            <li><a class="tiiga-footer__link" href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

</div>

{% stylesheet %}
  .tiiga-footer {
    background-color: var(--tf-bg, #1d5a6b);
    color: var(--tf-ink, #efece7);
    overflow: clip;
  }

  .tiiga-footer__inner {
    max-width: calc(1240px + 2 * clamp(16px, 4vw, 32px));
    margin-inline: auto;
    padding-block: clamp(48px, 7vw, 88px) 20px;
    padding-inline: clamp(16px, 4vw, 32px);
    box-sizing: border-box;
  }

  .tiiga-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .tiiga-footer__logo {
    display: block;
    width: 120px;
    height: auto;
    margin-block-end: 26px;
    /* The uploaded logo is the green-on-light original; knock it to the
       footer's ink so it sits on the teal. */
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  .tiiga-footer__eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-subheading--family);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(var(--tf-ink-rgb) / 0.62);
  }

  .tiiga-footer__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 500);
    font-size: clamp(1.875rem, 3.4vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: 0.005em;
    max-width: 14ch;
  }

  .tiiga-footer__blurb {
    margin: 16px 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 40ch;
    color: rgb(var(--tf-ink-rgb) / 0.78);
  }

  .tiiga-footer__signup-form {
    margin-block-start: 24px;
  }

  /* White pill with an integrated round arrow button — same pill language as
     the buy box and nav. */
  .tiiga-footer__signup {
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: 400px;
    background-color: #fff;
    border-radius: 999px;
    padding: 5px 5px 5px 0;
  }

  .tiiga-footer__signup:focus-within {
    outline: 2px solid var(--tf-ink);
    outline-offset: 3px;
  }

  /* Doubled scope: base.css styles input[type='email'] (0-1-1) with its own
     white box and 4px corners, which poke past the pill's curve — this must
     out-specify it to keep the input a bare flex child of the pill. */
  .tiiga-footer .tiiga-footer__signup-input {
    flex: 1;
    min-width: 0;
    appearance: none;
    border: 0;
    border-radius: 999px;
    background-color: transparent;
    box-shadow: none;
    font: inherit;
    font-size: 0.9375rem;
    color: #33302c;
    padding: 10px 8px 10px 20px;
  }

  .tiiga-footer__signup-input::placeholder {
    color: rgb(51 48 44 / 0.5);
  }

  .tiiga-footer__signup-input:focus-visible {
    outline: none;
  }

  .tiiga-footer__signup-button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background-color: #33302c;
    color: #fff;
    cursor: pointer;
    transition: background-color 0.18s ease;
  }

  .tiiga-footer__signup-button svg {
    width: 20px;
    height: 20px;
    transition: translate 0.18s ease;
  }

  .tiiga-footer__signup-button:hover {
    background-color: #4a453f;
  }

  .tiiga-footer__signup-button:hover svg {
    translate: 2px 0;
  }

  .tiiga-footer__signup-button:focus-visible {
    outline: 2px solid #33302c;
    outline-offset: 2px;
  }

  .tiiga-footer__signup-message {
    margin: 10px 0 0;
    font-size: 0.8125rem;
    color: rgb(var(--tf-ink-rgb) / 0.85);
  }

  .tiiga-footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, auto));
    gap: clamp(28px, 4vw, 64px);
    justify-content: end;
  }

  .tiiga-footer__col-heading {
    margin: 0 0 16px;
    font-family: var(--font-subheading--family);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--tf-ink-rgb) / 0.62);
  }

  .tiiga-footer__links,
  .tiiga-footer__social,
  .tiiga-footer__policies {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tiiga-footer__links li + li {
    margin-block-start: 10px;
  }

  .tiiga-footer__link {
    color: rgb(var(--tf-ink-rgb) / 0.82);
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.5;
    transition: color 0.15s ease;
  }

  .tiiga-footer__link:hover {
    color: var(--tf-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .tiiga-footer__link:focus-visible {
    outline: 2px solid var(--tf-ink);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .tiiga-footer__social {
    display: flex;
    gap: 10px;
  }

  .tiiga-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(var(--tf-ink-rgb) / 0.32);
    color: var(--tf-ink);
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }

  .tiiga-footer__social-link svg {
    width: 18px;
    height: 18px;
    /* The icon paths carry no fill of their own — without this they render
       SVG-default black, not the footer ink. */
    fill: currentColor;
  }

  .tiiga-footer__social-link:hover {
    background-color: var(--tf-ink);
    border-color: var(--tf-ink);
    color: var(--tf-bg);
  }

  .tiiga-footer__social-link:focus-visible {
    outline: 2px solid var(--tf-ink);
    outline-offset: 3px;
  }

  .tiiga-footer__utilities {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-block-start: clamp(40px, 6vw, 72px);
    padding-block: 22px;
    border-block-start: 1px solid rgb(var(--tf-ink-rgb) / 0.18);
  }

  .tiiga-footer__copyright {
    margin: 0;
    font-size: 0.8125rem;
    color: rgb(var(--tf-ink-rgb) / 0.62);
  }

  .tiiga-footer__policies {
    display: flex;
    gap: 8px 22px;
    flex-wrap: wrap;
  }

  .tiiga-footer__policies .tiiga-footer__link {
    font-size: 0.8125rem;
    color: rgb(var(--tf-ink-rgb) / 0.62);
  }

  .tiiga-footer__policies .tiiga-footer__link:hover {
    color: var(--tf-ink);
  }


  @media screen and (max-width: 989px) {
    .tiiga-footer__top {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .tiiga-footer__cols {
      justify-content: start;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .tiiga-footer__signup {
      max-width: none;
    }

    .tiiga-footer__utilities {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tiiga-footer__signup-button,
    .tiiga-footer__signup-button svg,
    .tiiga-footer__link,
    .tiiga-footer__social-link {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.tiiga_footer",
  "tag": "footer",
  "class": "tiiga-footer-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:settings.show_newsletter",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.menu"
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "t:settings.shop_heading",
      "default": "Shop"
    },
    {
      "type": "collection",
      "id": "shop_collection",
      "label": "t:settings.collection",
      "info": "t:info.tiiga_footer_shop_collection"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "t:settings.shop_all_label",
      "default": "Shop all"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "t:settings.menu"
    },
    {
      "type": "text",
      "id": "learn_heading",
      "label": "t:settings.learn_heading",
      "default": "Learn"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "t:settings.menu"
    },
    {
      "type": "header",
      "content": "t:content.social_links"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "t:settings.social_heading",
      "default": "Follow"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "t:settings.instagram"
    },
    {
      "type": "text",
      "id": "tiktok",
      "label": "t:settings.tiktok"
    },
    {
      "type": "text",
      "id": "facebook",
      "label": "t:settings.facebook"
    },
    {
      "type": "text",
      "id": "youtube",
      "label": "t:settings.youtube"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "#1d5a6b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text",
      "default": "#efece7"
    }
  ],
  "presets": [
    {
      "name": "t:names.tiiga_footer"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
