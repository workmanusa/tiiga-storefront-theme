<script
  src="{{ 'quiz.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{%- liquid
  assign packs = section.settings.packs_product
  assign tub = section.settings.tub_product
  assign packs_servings = section.settings.packs_servings | default: 16, allow_false: false
  assign tub_servings = section.settings.tub_servings | default: 30, allow_false: false

  assign packs_per_serving = 0
  assign tub_per_serving = 0
  assign save_percent = 0
  if packs != blank and packs_servings > 0
    assign packs_per_serving = packs.price | divided_by: packs_servings
  endif
  if tub != blank and tub_servings > 0
    assign tub_per_serving = tub.price | divided_by: tub_servings
  endif
  if packs_per_serving > 0 and tub_per_serving > 0 and tub_per_serving < packs_per_serving
    assign save_percent = packs_per_serving | minus: tub_per_serving | times: 100 | divided_by: packs_per_serving
  endif
  assign packs_per_serving_money = packs_per_serving | money
  assign tub_per_serving_money = tub_per_serving | money
-%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="quiz spacing-style section section--full-width color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <quiz-component
    class="quiz__component"
    data-klaviyo-key="{{ section.settings.klaviyo_public_key | escape }}"
    data-cart-url="{{ routes.cart_url }}"
  >
    <script type="application/json" data-quiz-data>
      {
        "reasons": {
          "gut": "You told us digestion is the priority. Tiiga leads with 5g of whole-fruit baobab prebiotic fiber to keep your rhythm steady, no harsh laxatives.",
          "energy": "You want steady energy. Baobab's vitamin C and B vitamins plus real electrolytes support energy without stimulants or crashes.",
          "hydration": "Hydration is your focus. Coconut water electrolytes with potassium, magnesium, and sodium make every sip count for more than plain water.",
          "immune": "You're thinking ahead. Every stick delivers 73mg of vitamin C, 80% of your daily value, plus baobab polyphenols.",
          "performance": "You push your body hard. Potassium, magnesium, and sodium replenish what sweat takes out, with 5g of fiber working for your gut.",
          "recovery": "Recovery is where progress happens. Electrolytes to rehydrate after hard sessions, fiber and polyphenols to keep your gut on your side.",
          "portable": "You need it mid-session. Pre-portioned sticks tuck into any gym bag and mix into any bottle, no scoop and no mess.",
          "sugar": "Cutting sugar? Tiiga has zero added sugar and 35 calories per serving, sweetened with organic stevia instead.",
          "first_timer": "New to Tiiga? The 16-stick pack is the low-commitment way to try the real fruit flavors and see how you feel.",
          "taste": "Taste-first? Same. Real fruit flavors, no chalky texture, nothing to choke down. Start with the 16-pack and find your favorite.",
          "clean": "You read labels. Organic baobab fruit, coconut water, no dyes, no artificial sweeteners, nothing you can't pronounce.",
          "value": "You want the math to work. Bigger sizes and subscriptions drop your cost per serving, so the more you commit, the less you pay per day."
        },
        "paths": [
          {
            "id": "womens",
            "label": "Women's wellness",
            "description": "Bloating, energy, hydration, and your cycle",
            "questions": [
              {
                "id": "concern",
                "text": "What's your biggest health concern right now?",
                "options": [
                  { "value": "bloating", "label": "Bloating and digestive discomfort" },
                  { "value": "energy", "label": "Low energy, especially mid-afternoon" },
                  { "value": "hydration", "label": "Staying hydrated throughout the day" },
                  { "value": "immune", "label": "Supporting my immune system" }
                ]
              },
              {
                "id": "bloatfreq",
                "text": "How often do you experience bloating or digestive issues?",
                "options": [
                  { "value": "daily", "label": "Daily, it's really affecting my life" },
                  { "value": "weekly", "label": "A few times a week" },
                  { "value": "occasional", "label": "Occasionally, depending on what I eat" },
                  { "value": "rarely", "label": "Rarely, and I want to keep it that way" }
                ]
              },
              {
                "id": "day",
                "text": "What does a typical day look like for you?",
                "options": [
                  { "value": "busy", "label": "Busy: work, kids, always on the go" },
                  { "value": "active", "label": "Active: I work out most days" },
                  { "value": "desk", "label": "Desk-based: mostly sitting at work" },
                  { "value": "mixed", "label": "Mixed: it varies week to week" }
                ]
              },
              {
                "id": "water",
                "text": "How much water do you drink daily?",
                "options": [
                  { "value": "under4", "label": "Less than 4 cups, I forget to drink" },
                  { "value": "cups4to6", "label": "4 to 6 cups, could be better" },
                  { "value": "cups6to8", "label": "6 to 8 cups consistently" },
                  { "value": "cups8plus", "label": "8+ cups, hydration is a priority" }
                ]
              },
              {
                "id": "flavor",
                "text": "Which flavor profile sounds most like you?",
                "options": [
                  { "value": "berry", "label": "Light and refreshing: berry and lemonade vibes" },
                  { "value": "tropical", "label": "Tropical and fruity: bold and bright" },
                  { "value": "both", "label": "I want to try both before committing" }
                ]
              }
            ]
          },
          {
            "id": "mens",
            "label": "Men's performance",
            "description": "Training, energy, and recovery",
            "questions": [
              {
                "id": "goal",
                "text": "What's your primary goal right now?",
                "options": [
                  { "value": "performance", "label": "Better workout performance and recovery" },
                  { "value": "energy", "label": "More consistent energy without crashes" },
                  { "value": "gut", "label": "Fixing digestion, I feel sluggish" },
                  { "value": "sugar", "label": "Cutting back on sports drinks and sugar" }
                ]
              },
              {
                "id": "workouts",
                "text": "How often do you work out or do physical activity?",
                "options": [
                  { "value": "daily", "label": "Every day or near daily" },
                  { "value": "threetofive", "label": "3 to 5 times a week" },
                  { "value": "onetotwo", "label": "1 to 2 times a week, trying to do more" },
                  { "value": "sedentary", "label": "Mostly sedentary, work keeps me busy" }
                ]
              },
              {
                "id": "drinks",
                "text": "What do you currently drink during or after workouts?",
                "options": [
                  { "value": "sports", "label": "Gatorade or sports drinks" },
                  { "value": "protein", "label": "Protein shakes or pre-workout" },
