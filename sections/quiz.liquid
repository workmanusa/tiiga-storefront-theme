                ]
              },
              {
                "id": "symptoms",
                "text": "Do you experience any of these regularly?",
                "options": [
                  { "value": "cramps", "label": "Muscle cramps or fatigue after exercise" },
                  { "value": "slumps", "label": "Afternoon energy slumps" },
                  { "value": "bloating", "label": "Bloating or slow digestion" },
                  { "value": "none", "label": "None of these, just want to optimize" }
                ]
              },
              {
                "id": "format",
                "text": "How do you prefer to take your supplements?",
                "options": [
                  { "value": "packs", "label": "Stick packs, easy for gym bag or work bag" },
                  { "value": "tub", "label": "Big tub at home, scoop daily" },
                  { "value": "autoship", "label": "Auto-ship it so I never run out" }
                ]
              }
            ]
          },
          {
            "id": "general",
            "label": "General health",
            "description": "Everyday wellness and daily habits",
            "questions": [
              {
                "id": "feeling",
                "text": "Which of these best describes how you feel most days?",
                "options": [
                  { "value": "tired", "label": "Tired and sluggish, even after sleep" },
                  { "value": "bloated", "label": "Gassy or bloated after meals" },
                  { "value": "dehydrated", "label": "Dehydrated, I don't drink enough water" },
                  { "value": "good", "label": "Pretty good, just want to feel even better" }
                ]
              },
              {
                "id": "matters",
                "text": "What matters most to you in a health supplement?",
                "options": [
                  { "value": "clean", "label": "Clean, organic ingredients, nothing artificial" },
                  { "value": "results", "label": "It actually works, proven results" },
                  { "value": "taste", "label": "Taste, I won't take it if it's gross" },
                  { "value": "value", "label": "Value, cost per serving matters" }
                ]
              },
              {
                "id": "tried",
                "text": "Have you ever tried a prebiotic or gut health supplement before?",
                "options": [
                  { "value": "loved", "label": "Yes, and I loved it" },
                  { "value": "meh", "label": "Yes, but it didn't taste great" },
                  { "value": "never", "label": "No, this would be my first time" },
                  { "value": "probiotics", "label": "I've tried probiotics but not prebiotics" }
                ]
              },
              {
                "id": "when",
                "text": "When would you most likely drink Tiiga?",
                "options": [
                  { "value": "morning", "label": "Morning, as part of my routine" },
                  { "value": "exercise", "label": "During or after exercise" },
                  { "value": "afternoon", "label": "Afternoon pick-me-up instead of coffee" },
                  { "value": "anytime", "label": "Anytime, I just want it on hand" }
                ]
              },
              {
                "id": "shop",
                "text": "How do you prefer to shop for wellness products?",
                "options": [
                  { "value": "tryfirst", "label": "One-time purchase first, I want to try it" },
                  { "value": "subscribe", "label": "Subscribe and save, if I like it I'm in" },
                  { "value": "bulk", "label": "Buy in bulk, I'm committed" }
                ]
              }
            ]
          },
          {
            "id": "active",
            "label": "Activity and performance",
            "description": "Serious training, hydration, and recovery",
            "questions": [
              {
                "id": "activity",
                "text": "What type of activity do you do most often?",
                "options": [
                  { "value": "strength", "label": "Weightlifting or strength training" },
                  { "value": "endurance", "label": "Running or endurance sports" },
                  { "value": "team", "label": "Team sports or CrossFit-style training" },
                  { "value": "lowimpact", "label": "Yoga, pilates, or low-impact movement" }
                ]
              },
              {
                "id": "challenge",
                "text": "What's your biggest challenge when it comes to performance?",
                "options": [
                  { "value": "recovery", "label": "Recovery takes too long after hard sessions" },
                  { "value": "cramps", "label": "I cramp up or fatigue faster than I'd like" },
                  { "value": "gut", "label": "Gut issues during or after training" },
                  { "value": "cleaner", "label": "I want cleaner hydration than sports drinks" }
                ]
              },
              {
                "id": "hydrate",
                "text": "How do you currently hydrate during workouts?",
                "options": [
                  { "value": "sugary", "label": "Sugary sports drinks like Gatorade or Powerade" },
                  { "value": "powders", "label": "Electrolyte powders or tablets" },
                  { "value": "water", "label": "Plain water only" },
                  { "value": "natural", "label": "Coconut water or natural drinks" }
                ]
              },
              {
                "id": "gutmatters",
                "text": "How important is gut health to your training?",
                "options": [
                  { "value": "very", "label": "Very, gut issues have hurt my performance" },
                  { "value": "somewhat", "label": "Somewhat, I've never thought about it much" },
                  { "value": "aware", "label": "I know it matters but haven't addressed it" },
                  { "value": "notreally", "label": "Not really, I'm focused on macros and training" }
                ]
              },
              {
                "id": "timing",
                "text": "When do you want to take Tiiga?",
                "options": [
                  { "value": "pre", "label": "Pre-workout for energy and hydration" },
                  { "value": "during", "label": "During, I need something portable" },
                  { "value": "post", "label": "Post-workout to recover faster" },
                  { "value": "daily", "label": "Daily as a habit, timing doesn't matter" }
                ]
              }
            ]
          }
        ]
      }
    </script>

    <div class="quiz__card">
      <div class="quiz__header" data-quiz-header hidden>
        <button type="button" class="quiz__back" data-quiz-back>
          {{ 'quiz.back' | t }}
        </button>
        <span
          class="quiz__count"
          data-quiz-count
          data-template="{{ 'quiz.question_count' | t: current: '[current]', total: '[total]' }}"
        ></span>
        <div class="quiz__progress" data-quiz-progress role="presentation">
          <span class="quiz__progress-fill"></span>
        </div>
      </div>

      <div class="quiz__panel quiz__panel--hero" data-quiz-panel="name">
        {% if section.settings.heading != blank %}
          <h1 class="quiz__hero-heading h1">{{ section.settings.heading | escape }}</h1>
        {% endif %}
        {% if section.settings.name_subtext != blank %}
          <p class="quiz__hero-subtext">{{ section.settings.name_subtext | escape }}</p>
        {% endif %}
        <form class="quiz__name-form" data-quiz-name-form>
          <label for="QuizName-{{ section.id }}" class="visually-hidden">
            {{ 'quiz.name_placeholder' | t }}
          </label>
          <input
            id="QuizName-{{ section.id }}"
            class="quiz__input quiz__name-input"
            type="text"
            name="first_name"
            autocomplete="given-name"
            autocapitalize="words"
            placeholder="{{ 'quiz.name_placeholder' | t }}"
            required
          >
          <button type="submit" class="button quiz__cta quiz__cta--wide">
            {{ 'quiz.get_started' | t }}
          </button>
        </form>
        <noscript>
          <p class="quiz__noscript">
            {{ 'quiz.noscript' | t }}
            <a href="{{ routes.all_products_collection_url }}">{{ 'quiz.noscript_link' | t }}</a>
          </p>
        </noscript>
      </div>

      <div class="quiz__panel" data-quiz-panel="intro" hidden>
        {% if section.settings.subheading != blank %}
          <h2 class="quiz__question h3">{{ section.settings.subheading | escape }}</h2>
        {% endif %}
        <p class="quiz__microcopy">{{ 'quiz.select_one' | t }}</p>
        <div class="quiz__paths">
          {%- liquid
            assign path_ids = 'womens,mens,general,active' | split: ','
            assign path_labels = "Women's wellness,Men's wellness,General health,Activity and performance" | split: ','
            assign path_hints = 'Bloating, energy, hydration, and your cycle;Training, energy, and recovery;Everyday wellness and daily habits;Serious training, hydration, and recovery' | split: ';'
          -%}
          {%- for path_id in path_ids -%}
            <button type="button" class="quiz__option quiz__option--path" data-path="{{ path_id }}">
              <span class="quiz__option-text">
                <span class="quiz__option-label">{{ path_labels[forloop.index0] }}</span>
                <span class="quiz__option-hint">{{ path_hints[forloop.index0] }}</span>
              </span>
              <span class="quiz__option-chevron">{{ 'icon-chevron-right.svg' | inline_asset_content }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="quiz__panel" data-quiz-panel="questions" hidden>
        <div
          class="quiz__stage"
          data-quiz-stage
          data-select-label="{{ 'quiz.select_one' | t }}"
          aria-live="polite"
        ></div>
      </div>

      <div class="quiz__panel" data-quiz-panel="email" hidden data-quiz-email>
        <h2 class="quiz__question h3">{{ 'quiz.email_heading' | t }}</h2>
        <p class="quiz__subheading">{{ 'quiz.email_subtext' | t }}</p>
        {%- form 'customer', class: 'quiz__email-form' -%}
          {% # A native fallback submit lands back on this page, not the footer anchor. %}
          <input type="hidden" name="return_to" value="{{ page.url | default: request.path }}">
          <input type="hidden" name="contact[tags]" value="">
          <input type="hidden" name="contact[first_name]" value="" data-quiz-first-name>
          <label for="QuizEmail-{{ section.id }}" class="visually-hidden">
            {{ 'quiz.email_placeholder' | t }}
          </label>
          <input
            id="QuizEmail-{{ section.id }}"
            class="quiz__email-input"
            type="email"
            name="contact[email]"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ 'quiz.email_placeholder' | t }}"
            required
          >
          <button type="submit" class="button quiz__submit">
            {{ 'quiz.get_results' | t }}
          </button>
        {%- endform -%}
        <p class="quiz__consent">{{ 'quiz.consent' | t }}</p>
      </div>

      <div class="quiz__panel" data-quiz-panel="result" hidden>
        <div class="quiz__result-header">
          <p
            class="quiz__result-eyebrow"
            data-quiz-result-eyebrow
            data-template="{{ 'quiz.personalized_for' | t: name: '[name]' }}"
          >
            {{ 'quiz.personalized_fallback' | t }}
          </p>
          {% if section.settings.result_heading != blank %}
            <h2 class="quiz__result-heading h1">{{ section.settings.result_heading | escape }}</h2>
          {% endif %}
          {% if section.settings.result_subtext != blank %}
            <p class="quiz__hero-subtext">{{ section.settings.result_subtext | escape }}</p>
          {% endif %}
        </div>

        <div class="quiz__result-sheet">

        {% if tub != blank %}
          <div class="quiz__result-card" data-quiz-result-card="tub" hidden>
            {% if tub.featured_image %}
              {%- capture tub_initial_image -%}
                {%- render 'quiz-variant-image', product: tub, target_variant: tub.selected_or_first_available_variant, width: 900 -%}
              {%- endcapture -%}
              {%- assign tub_initial_image = tub_initial_image | strip -%}
              <div class="quiz__result-media">
                <img
                  class="quiz__result-image"
                  src="{% if tub_initial_image != blank %}{{ tub_initial_image }}{% else %}{{ tub.featured_image | image_url: width: 900 }}{% endif %}"
                  alt="{{ tub.selected_or_first_available_variant.title | default: tub.title | escape }}"
                  width="450"
                  height="{{ 450 | divided_by: tub.featured_image.aspect_ratio | round }}"
                  loading="lazy"
                >
                {% render 'quiz-result-thumbs', product: tub %}
              </div>
            {% endif %}
            <div class="quiz__result-info">
              {%- assign tub_display_title = tub.title | split: '|' | first | remove_first: 'TIIGA' | strip -%}
              <h3 class="quiz__result-title h3">{{ tub_display_title }}</h3>
              <p class="quiz__reason" data-quiz-reason></p>
              {% if save_percent > 0 %}
                <p class="quiz__savings">
                  {{
                    'quiz.savings_line'
                    | t:
                      tub_price: tub_per_serving_money,
                      packs_price: packs_per_serving_money,
                      percent: save_percent
                  }}
                </p>
              {% endif %}
              <p class="quiz__subscription-tip" data-quiz-subscription-tip hidden>
                {{ 'quiz.subscribe_tip' | t }}
              </p>
              {% render 'quiz-buy-form', product: tub, section_id: section.id, form_id: 'tub' %}
              {% if packs != blank %}
                <a class="quiz__alt-link" href="{{ packs.url }}">
                  {{ 'quiz.start_smaller' | t }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}

        {% if packs != blank %}
          <div class="quiz__result-card" data-quiz-result-card="packs" hidden>
            {% if packs.featured_image %}
              {%- capture packs_initial_image -%}
                {%- render 'quiz-variant-image', product: packs, target_variant: packs.selected_or_first_available_variant, width: 900 -%}
              {%- endcapture -%}
              {%- assign packs_initial_image = packs_initial_image | strip -%}
              <div class="quiz__result-media">
                <img
                  class="quiz__result-image"
                  src="{% if packs_initial_image != blank %}{{ packs_initial_image }}{% else %}{{ packs.featured_image | image_url: width: 900 }}{% endif %}"
                  alt="{{ packs.selected_or_first_available_variant.title | default: packs.title | escape }}"
                  width="450"
                  height="{{ 450 | divided_by: packs.featured_image.aspect_ratio | round }}"
                  loading="lazy"
                >
                {% render 'quiz-result-thumbs', product: packs %}
              </div>
            {% endif %}
            <div class="quiz__result-info">
              {%- assign packs_display_title = packs.title | split: '|' | first | remove_first: 'TIIGA' | strip -%}
              <h3 class="quiz__result-title h3">{{ packs_display_title }}</h3>
              <p class="quiz__reason" data-quiz-reason></p>
              <p class="quiz__subscription-tip" data-quiz-subscription-tip hidden>
                {{ 'quiz.subscribe_tip' | t }}
              </p>
              {% render 'quiz-buy-form', product: packs, section_id: section.id, form_id: 'packs' %}
              {% if tub != blank and save_percent > 0 %}
                <a class="quiz__alt-link" href="{{ tub.url }}">
                  {{ 'quiz.upgrade_line' | t: percent: save_percent }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endif %}

          {% if section.settings.disclaimer != blank %}
            <p class="quiz__disclaimer">{{ section.settings.disclaimer | escape }}</p>
          {% endif %}
          <a href="#" class="quiz__skip" data-quiz-restart>{{ 'quiz.start_over' | t }}</a>
        </div>
      </div>
    </div>
  </quiz-component>
</div>

{% stylesheet %}
  .quiz {
    grid-column: 1 / -1;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 92svh;
    overflow: hidden;
    padding-inline: var(--padding-lg);
  }

  .quiz__backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .quiz__overlay {
    position: absolute;
    inset: 0;
  }

  .quiz__close {
    position: absolute;
    inset-block-start: var(--padding-lg);
    inset-inline-end: var(--padding-lg);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
    color: currentcolor;
    opacity: 0.8;
  }

  .quiz__close:hover {
    opacity: 1;
  }

  .quiz__close svg {
    width: 1.25rem;
    height: auto;
  }

  .quiz__component {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    max-width: 40rem;
    transition: max-width 0.3s ease;
  }

  @keyframes quiz-fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .quiz__panel:not([hidden]),
  .quiz__stage .quiz__question,
  .quiz__stage .quiz__microcopy,
  .quiz__stage .quiz__options {
    animation: quiz-fade-up 0.3s ease both;
  }

  .quiz__stage .quiz__options {
    animation-delay: 0.06s;
  }

  @media (prefers-reduced-motion: reduce) {
    .quiz__panel:not([hidden]),
    .quiz__stage .quiz__question,
    .quiz__stage .quiz__microcopy,
    .quiz__stage .quiz__options {
      animation: none;
    }

    .quiz__component {
      transition: none;
    }
  }

  .quiz__header[hidden],
  .quiz__result-card[hidden] {
    display: none;
  }

  .quiz__header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--gap-xs) var(--gap-md);
    margin-block-end: var(--margin-lg);
  }

  .quiz__back {
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    color: currentcolor;
    opacity: 0.75;
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    min-height: var(--minimum-touch-target);
    text-align: start;
  }

  .quiz__back:hover {
    opacity: 1;
  }

  .quiz__count {
    justify-self: end;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .quiz__progress {
    grid-column: 1 / -1;
    height: 4px;
    border-radius: 100px;
    background-color: rgb(var(--quiz-sheet-bg-rgb) / 0.25);
    overflow: hidden;
  }

  .quiz__progress-fill {
    display: block;
    height: 100%;
    width: var(--quiz-progress, 0%);
    border-radius: inherit;
    background-color: var(--quiz-sheet-bg);
    transition: width 0.25s ease;
  }

  .quiz__panel--hero {
    text-align: center;
  }

  .quiz__hero-heading {
    margin-block: 0 var(--margin-sm);
  }

  .quiz__hero-subtext {
    margin-block: 0 var(--margin-lg);
    opacity: 0.85;
  }

  .quiz__question {
    margin-block: 0 var(--margin-sm);
    text-align: center;
  }

  /* Headings receive programmatic focus for screen readers on step
     changes; the visible ring is noise for sighted users. */
  .quiz [tabindex='-1']:focus,
  .quiz [tabindex='-1']:focus-visible {
    outline: none;
  }

  .quiz__microcopy {
    margin-block: 0 var(--margin-sm);
    font-size: 0.8125rem;
    opacity: 0.7;
    text-align: start;
  }

  .quiz__name-form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    max-width: 26rem;
    margin-inline: auto;
  }

  .quiz__paths,
  .quiz__options {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .quiz__option {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    width: 100%;
    text-align: start;
    padding: var(--padding-md) var(--padding-lg);
    border: none;
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: rgb(var(--quiz-sheet-bg-rgb) / 0.78);
    color: var(--quiz-sheet-fg);
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.4;
    cursor: pointer;
    min-height: var(--minimum-touch-target);
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .quiz__option:hover,
  .quiz__option[aria-pressed='true'] {
    background-color: var(--quiz-sheet-bg);
  }

  .quiz__option[aria-pressed='true'] {
    transform: scale(1.01);
  }

  .quiz__option--path {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
  }

  .quiz__option-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .quiz__option-label {
    font-weight: 600;
  }

  .quiz__option-hint {
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .quiz__option-chevron {
    display: flex;
    flex-shrink: 0;
    width: 1rem;
    opacity: 0.4;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .quiz__option-chevron svg {
    width: 100%;
    height: auto;
  }

  .quiz__option--path:hover .quiz__option-chevron {
    transform: translateX(4px);
    opacity: 0.9;
  }

  .quiz__email-form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    max-width: 26rem;
    margin-inline: auto;
  }

  [data-quiz-panel='email'] {
    text-align: center;
  }

  [data-quiz-panel='email'] .quiz__hero-subtext {
    margin-block-end: var(--margin-md);
  }

  .quiz__input,
  .quiz__email-input {
    width: 100%;
    padding: var(--padding-md) var(--padding-lg);
    border: none;
    border-radius: var(--style-border-radius-inputs, 8px);
    background-color: rgb(var(--quiz-sheet-bg-rgb) / 0.95);
    color: var(--quiz-sheet-fg);
    font-size: 1rem;
    min-height: var(--minimum-touch-target);
  }

  .quiz__input::placeholder,
  .quiz__email-input::placeholder {
    color: rgb(var(--quiz-sheet-fg-rgb) / 0.55);
  }

  .quiz__consent {
    margin-block: var(--margin-sm) 0;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .quiz__skip {
    display: inline-block;
    margin-block-start: var(--margin-md);
    font-size: 0.875rem;
    color: currentcolor;
    opacity: 0.7;
    text-underline-offset: 0.2em;
  }

  .quiz__skip:hover {
    opacity: 1;
  }

  .quiz__result-header {
    text-align: center;
    margin-block-end: var(--margin-lg);
  }

  .quiz__result-eyebrow {
    margin-block: 0 var(--margin-2xs, 0.25rem);
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .quiz__result-heading {
    margin-block: 0 var(--margin-xs);
    text-transform: uppercase;
  }

  .quiz__result-sheet {
    --color-background: var(--quiz-sheet-bg);
    --color-background-rgb: var(--quiz-sheet-bg-rgb);
    --color-foreground: var(--quiz-sheet-fg);
    --color-foreground-rgb: var(--quiz-sheet-fg-rgb);

    background-color: var(--quiz-sheet-bg);
    color: var(--quiz-sheet-fg);
    border-radius: var(--style-border-radius-cards, 12px);
    padding: var(--padding-xl);
    text-align: start;
  }

  .quiz__result-sheet .quiz__result-title {
    color: currentcolor;
  }

  .quiz__result-card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .quiz__result-card:not([hidden]) ~ .quiz__result-card:not([hidden]) {
    margin-block-start: var(--margin-xl);
    padding-block-start: var(--padding-xl);
    border-block-start: 1px solid rgb(var(--quiz-sheet-fg-rgb) / 0.15);
  }

  .quiz__result-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
  }

  .quiz__result-title {
    margin-block: 0;
  }

  .quiz__result-media {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .quiz__result-media .quiz__result-image {
    border-radius: var(--style-border-radius-cards, 12px);
  }

  .quiz__result-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .quiz__result-thumb {
    padding: 0;
    width: 3.5rem;
    height: 3.5rem;
    border: 2px solid transparent;
    border-radius: 8px;
    background: none;
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.15s ease, opacity 0.15s ease;
    opacity: 0.75;
  }

  .quiz__result-thumb:hover,
  .quiz__result-thumb[aria-pressed='true'] {
    opacity: 1;
  }

  .quiz__result-thumb[aria-pressed='true'] {
    border-color: currentcolor;
  }

  .quiz__result-thumb[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .quiz__result-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }

  .quiz__result-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 320px;
    object-fit: contain;
  }

  .quiz__reason,
  .quiz__savings,
  .quiz__subscription-tip {
    margin-block: 0;
  }

  .quiz__savings,
  .quiz__subscription-tip {
    font-size: 0.9375rem;
    opacity: 0.85;
  }

  .quiz__cta {
    margin-block-start: var(--margin-sm);
  }

  .quiz__cta--wide {
    margin-block-start: 0;
    width: 100%;
  }

  .quiz__buy-form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-sm);
    width: 100%;
    margin-block-start: var(--margin-sm);
  }

  .quiz__flavor-select {
    position: relative;
    width: 100%;
    max-width: 22rem;
  }

  .quiz__flavor-toggle {
    display: none;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    text-align: start;
    padding: 0.625rem 0.875rem;
    border: 1.5px solid rgb(var(--quiz-sheet-fg-rgb) / 0.2);
    border-radius: 12px;
    background-color: #fff;
    color: var(--quiz-sheet-fg);
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    min-height: var(--minimum-touch-target);
  }

  .quiz__flavor-caret {
    display: flex;
    margin-inline-start: auto;
    width: 0.75rem;
    opacity: 0.6;
    transition: transform 0.15s ease;
  }

  .quiz__flavor-caret svg {
    width: 100%;
    height: auto;
  }

  .quiz__flavor-select[data-open] .quiz__flavor-caret {
    transform: rotate(180deg);
  }

  .quiz__flavor-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .quiz__flavor-toggle {
      display: flex;
    }

    .quiz__flavor-list {
      display: none;
      position: absolute;
      inset-inline: 0;
      inset-block-start: calc(100% + 0.25rem);
      z-index: 5;
      padding: 0.25rem;
      background-color: #fff;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgb(0 0 0 / 0.16);
      max-height: 16rem;
      overflow-y: auto;
    }

    .quiz__flavor-select[data-open] .quiz__flavor-list {
      display: flex;
    }

    .quiz__flavor-list .quiz__flavor-row[aria-pressed='true'] {
      background-color: rgb(var(--quiz-sheet-fg-rgb) / 0.07);
      box-shadow: none;
    }
  }

  .quiz__flavor-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    text-align: start;
    padding: 0.5rem 0.875rem;
    border: none;
    border-radius: 12px;
    background-color: transparent;
    color: var(--quiz-sheet-fg);
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    cursor: pointer;
    min-height: 2.5rem;
    opacity: 0.6;
    transition: opacity 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .quiz__flavor-row:hover {
    opacity: 1;
  }

  .quiz__flavor-row[aria-pressed='true'] {
    opacity: 1;
    background-color: #fff;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
    font-weight: 600;
  }

  .quiz__flavor-row[disabled] {
    opacity: 0.35;
    cursor: default;
    text-decoration: line-through;
  }

  .quiz__flavor-dot {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    flex-shrink: 0;
    background-color: var(--flavor-swatch, rgb(var(--quiz-sheet-fg-rgb) / 0.25));
  }

  .quiz__buy-row {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    width: 100%;
    margin-block-start: var(--margin-sm);
  }

  .quiz__quantity {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    border: 1.5px solid rgb(var(--quiz-sheet-fg-rgb) / 0.2);
    border-radius: 100px;
    background-color: #fff;
  }

  .quiz__quantity-button {
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--quiz-sheet-fg);
    font-size: 1.125rem;
    line-height: 1;
    width: 2.5rem;
    min-height: var(--minimum-touch-target);
  }

  .quiz__quantity-input {
    width: 2rem;
    border: none;
    background: transparent;
    color: var(--quiz-sheet-fg);
    font-size: 1rem;
    text-align: center;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .quiz__quantity-input::-webkit-outer-spin-button,
  .quiz__quantity-input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .quiz__buy-row .quiz__cta {
    flex-grow: 1;
    margin-block-start: 0;
  }

  .quiz__details-link {
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: currentcolor;
    text-underline-offset: 0.25em;
    margin-block-start: var(--margin-xs);
  }

  .quiz__cart-error {
    margin-block: 0;
    font-size: 0.875rem;
    color: var(--color-error, #b3261e);
  }

  .quiz__disclaimer {
    margin-block: var(--margin-lg) 0;
    font-size: 0.6875rem;
    opacity: 0.6;
  }

  .quiz__noscript {
    margin-block-start: var(--margin-md);
  }

  @media screen and (min-width: 750px) {
    .quiz__component:has([data-quiz-panel='result']:not([hidden])) {
      max-width: 58rem;
    }

    .quiz__result-card {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--gap-2xl, 2.5rem);
      align-items: start;
    }

    .quiz__result-image {
      max-height: none;
      aspect-ratio: 1;
      object-fit: cover;
    }
  }

  @media screen and (max-width: 749px) {
    .quiz {
      padding-inline: var(--padding-md);
    }

    .quiz__result-sheet {
      padding: var(--padding-lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.quiz",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Feel-good hydration starts here."
    },
    {
      "type": "text",
      "id": "name_subtext",
      "label": "t:settings.quiz_name_subtext",
      "default": "You can get your match in about 2 minutes. What's your first name?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "Which sounds most like you?"
    },
    {
      "type": "header",
      "content": "t:content.quiz_results"
    },
    {
      "type": "text",
      "id": "result_heading",
      "label": "t:settings.heading",
      "default": "Your Tiiga match"
    },
    {
      "type": "text",
      "id": "result_subtext",
      "label": "t:settings.subheading",
      "default": "The results are in: here's the product we picked from your answers."
    },
    {
      "type": "header",
      "content": "t:content.products"
    },
    {
      "type": "product",
      "id": "packs_product",
      "label": "t:settings.quiz_packs_product"
    },
    {
      "type": "number",
      "id": "packs_servings",
      "label": "t:settings.quiz_packs_servings",
      "default": 16
    },
    {
      "type": "product",
      "id": "tub_product",
      "label": "t:settings.quiz_tub_product"
    },
    {
      "type": "number",
      "id": "tub_servings",
      "label": "t:settings.quiz_tub_servings",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:content.quiz_integrations"
    },
    {
      "type": "text",
      "id": "klaviyo_public_key",
      "label": "t:settings.klaviyo_company_id",
      "info": "t:info.quiz_klaviyo_key"
    },
    {
      "type": "text",
      "id": "klaviyo_list_id",
      "label": "t:settings.quiz_klaviyo_list",
      "info": "t:info.quiz_klaviyo_list"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "t:settings.quiz_disclaimer",
      "default": "These statements have not been evaluated by the FDA. This product is not intended to diagnose, treat, cure, or prevent any disease."
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:content.background_image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#12333dd9"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "sheet_color",
      "label": "t:settings.quiz_sheet_color",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "sheet_text_color",
      "label": "t:settings.quiz_sheet_text_color",
      "default": "#1f2a2c"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:names.quiz"
    }
  ]
}
{% endschema %}
