{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="brand-values spacing-style section section--page-width color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %};
    --brand-values-accent: {{ section.settings.accent_color }};
    --brand-values-card: {{ section.settings.card_color }};
    --brand-values-columns: {{ section.settings.columns }};
  "
>
  <div class="brand-values__inner">
    <div class="brand-values__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-values__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="brand-values__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="brand-values__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="brand-values__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .brand-values__inner {
    display: grid;
    gap: 2.5rem;
  }

  .brand-values__header {
    max-width: 44rem;
  }

  .brand-values__eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-values-accent);
  }

  .brand-values__heading {
    margin: 0;
  }

  .brand-values__text {
    margin-block-start: 1rem;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .brand-values__text > :first-child {
    margin-block-start: 0;
  }

  .brand-values__text > :last-child {
    margin-block-end: 0;
  }

  .brand-values__grid {
    display: grid;
    grid-template-columns: repeat(var(--brand-values-columns, 2), minmax(0, 1fr));
    gap: 1rem;
  }

  @media screen and (max-width: 989px) {
    .brand-values__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .brand-values__inner {
      gap: 1.75rem;
    }

    .brand-values__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.brand_values",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "#1d5a6b"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "t:settings.background_color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "_brand-value"
    }
  ],
  "presets": [
    {
      "name": "t:names.brand_values",
      "category": "t:categories.storytelling",
      "blocks": {
        "value_1": { "type": "_brand-value" },
        "value_2": { "type": "_brand-value" },
        "value_3": { "type": "_brand-value" },
        "value_4": { "type": "_brand-value" }
      },
      "block_order": ["value_1", "value_2", "value_3", "value_4"]
    }
  ]
}
{% endschema %}
