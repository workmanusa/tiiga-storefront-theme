{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{% capture slides %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign show_arrows = true
  if section.blocks.size <= 1
    assign show_arrows = false
  endif
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="ingredient-cards spacing-style section section--full-width color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --ingredient-card-width: {{ section.settings.card_width }}px;"
>
  <div class="ingredient-cards__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="ingredient-cards__heading h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="ingredient-cards__text">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  {% render 'slideshow',
    class: 'ingredient-cards__slideshow',
    slides: slides,
    slide_count: section.blocks.size,
    show_arrows: show_arrows,
    icon_style: 'chevron',
    icon_shape: 'circle',
    infinite: false,
    auto_hide_controls: true
  %}
</div>

{% stylesheet %}
  .ingredient-cards {
    grid-column: 1 / -1;
    overflow: hidden;

    /* One inset for the header and the card rail, in vw so it resolves the
       same regardless of each element's containing block. Uses the theme's
       --page-width (defined on body) so it lines up with the other sections. */
    --ingredient-cards-inset: max(3rem, calc((100vw - var(--page-width, 1300px)) / 2 + 3rem));
  }

  .ingredient-cards__header {
    display: grid;
    gap: 1rem 4rem;
    padding-inline: var(--ingredient-cards-inset);
    margin-block-end: 2.5rem;

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .ingredient-cards__heading {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2.25rem, 3.6vw, 3.5rem);
    line-height: 1.08;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .ingredient-cards__text {
    max-width: 36rem;

    @media screen and (min-width: 990px) {
      padding-block-start: 0.5rem;
    }
  }

  .ingredient-cards__text p {
    margin: 0;
  }

  /* Reference mobile rhythm: tighter insets, smaller single-line heading */
  @media screen and (max-width: 749px) {
    .ingredient-cards {
      --ingredient-cards-inset: 1.5rem;
    }

    .ingredient-cards.spacing-style {
      padding-block: 2.5rem 3rem;
    }

    .ingredient-cards__heading {
      max-width: none;
      font-size: 1.75rem;
    }

    .ingredient-cards__header {
      margin-block-end: 1.5rem;
    }
  }

  /* Cards: fixed-width slides that overflow and scroll, starting at the same
     inset as the header */
  .ingredient-cards slideshow-slides {
    padding-inline: var(--ingredient-cards-inset);
    scroll-padding-inline-start: var(--ingredient-cards-inset);
    gap: 1rem;
  }

  .ingredient-cards slideshow-slide {
    width: min(var(--ingredient-card-width, 320px), 78vw);
    scroll-snap-align: start;
  }

  .ingredient-cards slideshow-arrows {
    mix-blend-mode: normal;
    align-items: center;
    padding-inline: 1.5rem;

    /* Touch scrolling handles the rail on phones — arrows are desktop-only */
    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  /* Arrows use the theme's default hover reveal: hidden until the rail is
     hovered or focused, so no extra rules needed here. */
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.ingredient_cards",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "t:settings.width",
      "min": 220,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "_ingredient-card"
    }
  ],
  "presets": [
    {
      "name": "t:names.ingredient_cards",
      "category": "t:categories.storytelling",
      "blocks": {
        "card_1": { "type": "_ingredient-card" },
        "card_2": { "type": "_ingredient-card" },
        "card_3": { "type": "_ingredient-card" }
      },
      "block_order": ["card_1", "card_2", "card_3"]
    }
  ]
}
{% endschema %}
