{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<script
  src="{{ 'statement-collage.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="statement spacing-style section section--full-width color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %};
    --statement-accent: {{ section.settings.accent_color }};
    --statement-height: {{ section.settings.height }}vh;
  "
>
  <statement-collage-component class="statement__stage">
    {%- comment -%}
      The scatter is decorative framing for the statement, so it is hidden
      from assistive tech rather than read out as a list of images.
    {%- endcomment -%}
    <div class="statement__photos" ref="photos" aria-hidden="true">
      {% content_for 'blocks' %}
    </div>

    <div class="statement__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="statement__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="statement__headline">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="statement__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </statement-collage-component>
</div>

{% stylesheet %}
  .statement {
    grid-column: 1 / -1;
    overflow: hidden;
  }

  .statement__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: var(--statement-height, 82vh);
  }

  .statement__photos {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .statement__content {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    text-align: center;
  }

  .statement__eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--statement-accent);
  }

  .statement__headline {
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.375rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .statement__text {
    margin-block-start: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgb(var(--color-foreground-rgb) / 0.75);
  }

  .statement__text > :first-child {
    margin-block-start: 0;
  }

  .statement__text > :last-child {
    margin-block-end: 0;
  }

  @media screen and (max-width: 749px) {
    .statement__stage {
      min-height: 0;
      /* The scatter needs room above and below the words on a narrow screen */
      padding-block: 22vh;
    }

    .statement__content {
      max-width: 26rem;
    }

    .statement__text {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.statement_collage",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "range",
      "id": "height",
      "label": "t:settings.height",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 82
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "#1d5a6b"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "_collage-photo"
    }
  ],
  "presets": [
    {
      "name": "t:names.statement_collage",
      "category": "t:categories.storytelling",
      "blocks": {
        "photo_1": { "type": "_collage-photo" },
        "photo_2": { "type": "_collage-photo" },
        "photo_3": { "type": "_collage-photo" },
        "photo_4": { "type": "_collage-photo" }
      },
      "block_order": ["photo_1", "photo_2", "photo_3", "photo_4"]
    }
  ]
}
{% endschema %}
