<script
  src="{{ 'flavor-tabs.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="flavor-tabs spacing-style section section--full-width color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <flavor-tabs-component>
    <div
      class="flavor-tabs__list"
      role="tablist"
      aria-label="{{ 'accessibility.product_tabs' | t }}"
    >
      {%- for i in (1..3) -%}
        {%- liquid
          assign label_key = 'label_' | append: i
          assign label = section.settings[label_key]
        -%}
        {%- if label != blank -%}
          <button
            type="button"
            class="flavor-tabs__tab"
            id="FlavorTab-{{ section.id }}-{{ i }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {{ label }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </flavor-tabs-component>
</div>

{% stylesheet %}
  .flavor-tabs {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
  }

  .flavor-tabs__list {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background-color: rgb(255 255 255 / 0.9);
    border-radius: 100px;
  }

  .flavor-tabs__tab {
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0.5rem 1.125rem;
    border-radius: 100px;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground);
    min-height: var(--minimum-touch-target);
  }

  .flavor-tabs__tab[aria-selected='true'] {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.flavor_tabs",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.flavor_tabs_help"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "t:settings.label"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "t:settings.label"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "t:settings.label"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.flavor_tabs"
    }
  ]
}
{% endschema %}
