{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="whats-not-inside spacing-style section section--full-width color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="whats-not-inside__inner">
    <div class="whats-not-inside__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="whats-not-inside__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="whats-not-inside__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="whats-not-inside__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="whats-not-inside__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .whats-not-inside {
    grid-column: 1 / -1;

    /* Same inset formula as the ingredient cards section above, so the two
       sections' content edges line up at every viewport width */
    --whats-not-inside-inset: max(3rem, calc((100vw - var(--page-width, 1300px)) / 2 + 3rem));
  }

  .whats-not-inside__inner {
    padding-inline: var(--whats-not-inside-inset);
    display: grid;
    gap: 2.5rem 4rem;

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      align-items: start;
    }
  }

  .whats-not-inside__eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-subheading--family);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .whats-not-inside__heading {
    margin: 0;
    font-size: clamp(2.25rem, 3.6vw, 3.25rem);
    line-height: 1.08;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .whats-not-inside__text {
    max-width: 24rem;
    margin-block-start: 1rem;
    font-size: 0.9375rem;
  }

  .whats-not-inside__text p {
    margin: 0;
  }

  .whats-not-inside__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-content: start;

    @media screen and (min-width: 990px) {
      /* Header column baseline sits a little above the first pill row in the
         reference — nudge the grid to line up with the eyebrow */
      margin-block-start: 0.25rem;
    }
  }

  @media screen and (max-width: 749px) {
    .whats-not-inside {
      --whats-not-inside-inset: 1.5rem;
    }

    .whats-not-inside__inner {
      gap: 1.75rem;
    }

    .whats-not-inside.spacing-style {
      padding-block: 2.5rem 3rem;
    }

    .whats-not-inside__heading {
      font-size: 1.875rem;
    }

    .whats-not-inside__grid {
      gap: 0.875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.whats_not_inside",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "_not-inside-item"
    }
  ],
  "presets": [
    {
      "name": "t:names.whats_not_inside",
      "category": "t:categories.storytelling",
      "blocks": {
        "item_1": { "type": "_not-inside-item" },
        "item_2": { "type": "_not-inside-item" },
        "item_3": { "type": "_not-inside-item" },
        "item_4": { "type": "_not-inside-item" }
      },
      "block_order": ["item_1", "item_2", "item_3", "item_4"]
    }
  ]
}
{% endschema %}
