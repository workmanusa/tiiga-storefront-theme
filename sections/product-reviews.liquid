{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<script src="{{ 'product-reviews.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% liquid
  assign count_5 = section.settings.stars_5 | default: 0
  assign count_4 = section.settings.stars_4 | default: 0
  assign count_3 = section.settings.stars_3 | default: 0
  assign count_2 = section.settings.stars_2 | default: 0
  assign count_1 = section.settings.stars_1 | default: 0
  assign histogram_total = count_5 | plus: count_4 | plus: count_3 | plus: count_2 | plus: count_1

  # Klaviyo Reviews syncs aggregates to the standard reviews.* metafields;
  # section settings act as a fallback until the first review syncs.
  assign rating_source = product.metafields.reviews.rating.value
  assign rating_display = rating_source.rating | default: rating_source
  if rating_display == blank
    assign rating_display = section.settings.rating
  else
    assign rating_display = rating_display | times: 1.0 | round: 1
  endif
  assign review_count_display = product.metafields.reviews.rating_count.value | default: section.settings.review_count

  assign klaviyo_enabled = false
  if section.settings.klaviyo_company_id != blank and product != blank
    assign klaviyo_enabled = true
  endif

  assign media_count = 0
  assign review_block_count = 0
  for block in section.blocks
    if block.type != 'review'
      continue
    endif
    assign review_block_count = review_block_count | plus: 1
    if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank
      assign media_count = media_count | plus: 1
    endif
  endfor
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<product-reviews
  id="product-reviews"
  class="product-reviews spacing-style section section--full-width color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {% if klaviyo_enabled %}
    data-klaviyo-company="{{ section.settings.klaviyo_company_id }}"
    data-product-id="{% if section.settings.combine_reviews %}all{% else %}{{ product.id }}{% endif %}"
  {% endif %}
>
  {%- if klaviyo_enabled -%}
    <script type="application/json" data-ref="klaviyo-strings">
      {
        "verified": {{ 'reviews.verified_buyer' | t | json }},
        "starsLabel": {{ 'reviews.stars_label' | t: rating: '__RATING__' | json }},
        "basedOn": {{ 'reviews.based_on' | t: count: '__COUNT__' | json }},
        "countLabel": {{ 'reviews.count_label' | t: count: '__COUNT__' | json }},
        "onProduct": {{ 'reviews.on_product' | t: product: '__PRODUCT__' | json }},
        "openReview": {{ 'reviews.open_review' | t: author: '__AUTHOR__' | json }},
        "reviewBy": {{ 'reviews.review_by' | t: author: '__AUTHOR__' | json }},
        "close": {{ 'reviews.close' | t | json }}
      }
    </script>
  {%- endif -%}
  <div class="product-reviews__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-reviews__heading h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="product-reviews__summary">
      <div class="product-reviews__average">
        <span class="product-reviews__average-value" data-ref="averageValue">{{ rating_display }}</span>
        <div class="product-reviews__average-meta">
          <span
            class="product-reviews__stars product-reviews__stars--average"
            role="img"
            data-ref="averageStars"
            aria-label="{{ 'reviews.stars_label' | t: rating: rating_display }}"
          >
            <span class="product-reviews__stars-track" aria-hidden="true">★★★★★</span>
            <span
              class="product-reviews__stars-fill"
              aria-hidden="true"
              data-ref="averageFill"
              style="width: {{ rating_display | times: 20.0 | at_most: 100 }}%"
            >
              ★★★★★
            </span>
          </span>
          {%- if review_count_display != blank or klaviyo_enabled -%}
            <span class="product-reviews__based-on" data-ref="basedOn">
              {%- if review_count_display != blank -%}
                {{- 'reviews.based_on' | t: count: review_count_display -}}
              {%- endif -%}
            </span>
          {%- endif -%}
        </div>
      </div>

      {%- if histogram_total > 0 or klaviyo_enabled -%}
        <ul class="product-reviews__histogram" role="list">
          {%- for star in (1..5) reversed -%}
            {%- liquid
              case star
                when 5
                  assign row_count = count_5
                when 4
                  assign row_count = count_4
                when 3
                  assign row_count = count_3
                when 2
                  assign row_count = count_2
                else
                  assign row_count = count_1
              endcase
              assign row_width = row_count | times: 100.0 | divided_by: histogram_total | round
            -%}
            <li class="product-reviews__histogram-row" data-star="{{ star }}">
              <span class="product-reviews__histogram-star">
                {{ star }}
                <span aria-hidden="true">★</span>
              </span>
              <span class="product-reviews__histogram-bar" aria-hidden="true">
                <span class="product-reviews__histogram-fill" style="width: {{ row_width }}%"></span>
              </span>
              <span class="product-reviews__histogram-count">{{ row_count }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="product-reviews__cta">
          <a class="button" href="{{ section.settings.button_link | default: '#' }}">
            {{- section.settings.button_label -}}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if media_count > 0 or klaviyo_enabled -%}
      <div class="product-reviews__media" data-ref="mediaSection" {% if media_count == 0 %}hidden{% endif %}>
        {%- if section.settings.media_heading != blank -%}
          <h3 class="product-reviews__media-heading">{{ section.settings.media_heading }}</h3>
        {%- endif -%}

        {%- if klaviyo_enabled -%}
          <div class="product-reviews__media-rail" data-ref="liveMedia" hidden></div>
        {%- endif -%}
        {%- capture media_slides -%}
          {%- liquid
            assign slide_index = 0
            for block in section.blocks
              assign first_image = block.settings.image_1 | default: block.settings.image_2 | default: block.settings.image_3
              if first_image == blank
                continue
              endif
              capture thumb
                echo '<button type="button" class="product-reviews__media-thumb" data-open-review="' | append: block.id | append: '" aria-label="'
                echo 'reviews.open_review' | t: author: block.settings.author | escape
                echo '">'
                echo first_image | image_url: width: 480 | image_tag: widths: '240, 480', sizes: '176px', class: 'product-reviews__media-image', loading: 'lazy'
                echo '</button>'
              endcapture
              render 'slideshow-slide', index: slide_index, children: thumb
              assign slide_index = slide_index | plus: 1
            endfor
          -%}
        {%- endcapture -%}

        {%- if media_count > 0 -%}
          {% liquid
            assign show_media_arrows = true
            if media_count <= 1
              assign show_media_arrows = false
            endif
          %}
          {% render 'slideshow',
            class: 'product-reviews__media-slideshow',
            slides: media_slides,
            slide_count: media_count,
            show_arrows: show_media_arrows,
            icon_style: 'chevron',
            icon_shape: 'circle',
            infinite: false,
            auto_hide_controls: true
          %}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      The Klaviyo product reviews widget is added here as an app block in the
      theme editor; it renders the live review list, photos and filters.
    {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="product-reviews__app-widget" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- assign visible_reviews = section.settings.visible_reviews | default: 3 -%}
    {%- assign review_index = 0 -%}
    <div class="product-reviews__list" data-ref="list">
      {%- for block in section.blocks -%}
        {%- if block.type != 'review' -%}
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign review_index = review_index | plus: 1
          assign stars_filled = '★★★★★' | slice: 0, block.settings.rating
          assign stars_empty_count = 5 | minus: block.settings.rating
          assign stars_empty = '★★★★★' | slice: 0, stars_empty_count
        -%}
        <article
          class="product-reviews__review"
          {% if review_index > visible_reviews %}
            hidden
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <div class="product-reviews__reviewer">
            <span class="product-reviews__avatar" aria-hidden="true">
              {{- block.settings.author | slice: 0, 1 -}}
            </span>
            <div class="product-reviews__reviewer-meta">
              <span class="product-reviews__author">{{ block.settings.author }}</span>
              {%- if block.settings.verified -%}
                <span class="product-reviews__verified">
                  <span class="product-reviews__verified-check" aria-hidden="true">
                    {{- 'icon-checkmark.svg' | inline_asset_content -}}
                  </span>
                  {{ 'reviews.verified_buyer' | t }}
                </span>
              {%- endif -%}
            </div>
          </div>

          <div class="product-reviews__body">
            <div class="product-reviews__review-header">
              <span
                class="product-reviews__stars"
                role="img"
                aria-label="{{ 'reviews.stars_label' | t: rating: block.settings.rating }}"
              >
                {{- stars_filled -}}
                <span class="product-reviews__stars-empty" aria-hidden="true">{{ stars_empty }}</span>
              </span>
              {%- if block.settings.title != blank -%}
                <h3 class="product-reviews__review-title">{{ block.settings.title }}</h3>
              {%- endif -%}
            </div>

            {%- if block.settings.text != blank -%}
              <p class="product-reviews__review-text">{{ block.settings.text }}</p>
            {%- endif -%}

            {%- liquid
              assign has_media = false
              if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank
                assign has_media = true
              endif
            -%}
            {%- if has_media -%}
              <div class="product-reviews__review-thumbs">
                {%- liquid
                  assign image_index = 0
                  for i in (1..3)
                    assign image_key = 'image_' | append: i
                    assign review_image = block.settings[image_key]
                    if review_image == blank
                      continue
                    endif
                    echo '<button type="button" class="product-reviews__review-thumb" data-open-review="' | append: block.id | append: '" data-image-index="' | append: image_index | append: '" aria-label="'
                    echo 'reviews.open_review' | t: author: block.settings.author | escape
                    echo '">'
                    echo review_image | image_url: width: 160 | image_tag: class: 'product-reviews__review-thumb-image', loading: 'lazy'
                    echo '</button>'
                    assign image_index = image_index | plus: 1
                  endfor
                -%}
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.date != blank -%}
            <span class="product-reviews__date">{{ block.settings.date }}</span>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if review_block_count > visible_reviews or klaviyo_enabled -%}
      <div
        class="product-reviews__show-more"
        data-ref="showMore"
        {% if review_block_count <= visible_reviews %}
          hidden
        {% endif %}
      >
        <button type="button" class="button-secondary" data-action="show-more">
          {{- 'reviews.show_more' | t -}}
        </button>
      </div>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type != 'review' -%}
      {%- continue -%}
    {%- endif -%}
    {%- liquid
      assign has_media = false
      if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank
        assign has_media = true
      endif
    -%}
    {%- if has_media -%}
      <dialog
        class="review-dialog"
        data-review-dialog="{{ block.id }}"
        aria-label="{{ 'reviews.review_by' | t: author: block.settings.author }}"
      >
        <button type="button" class="review-dialog__close" data-action="close">
          <span class="visually-hidden">{{ 'reviews.close' | t }}</span>
          <span aria-hidden="true">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>

        <div class="review-dialog__layout">
          <div class="review-dialog__media">
            <button type="button" class="review-dialog__nav review-dialog__nav--prev" data-step="-1">
              <span class="visually-hidden">{{ 'reviews.previous_image' | t }}</span>
              <span aria-hidden="true">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>

            {%- liquid
              assign image_index = 0
              for i in (1..3)
                assign image_key = 'image_' | append: i
                assign review_image = block.settings[image_key]
                if review_image == blank
                  continue
                endif
                if image_index == 0
                  echo review_image | image_url: width: 1100 | image_tag: widths: '550, 800, 1100', class: 'review-dialog__image', loading: 'lazy', attributes: 'data-review-image'
                else
                  echo review_image | image_url: width: 1100 | image_tag: widths: '550, 800, 1100', class: 'review-dialog__image', loading: 'lazy', attributes: 'data-review-image hidden'
                endif
                assign image_index = image_index | plus: 1
              endfor
            -%}

            <button type="button" class="review-dialog__nav review-dialog__nav--next" data-step="1">
              <span class="visually-hidden">{{ 'reviews.next_image' | t }}</span>
              <span aria-hidden="true">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          <div class="review-dialog__content">
            <div class="review-dialog__header">
              <span class="review-dialog__avatar" aria-hidden="true">
                {{- block.settings.author | slice: 0, 1 -}}
              </span>
              <div class="review-dialog__reviewer">
                <span class="review-dialog__author">{{ block.settings.author }}</span>
                {%- if block.settings.verified -%}
                  <span class="review-dialog__verified">
                    <span class="review-dialog__verified-check" aria-hidden="true">
                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                    </span>
                    {{ 'reviews.verified_buyer' | t }}
                  </span>
                {%- endif -%}
              </div>
              {%- if block.settings.date != blank -%}
                <span class="review-dialog__date">{{ block.settings.date }}</span>
              {%- endif -%}
            </div>

            {%- liquid
              assign stars_filled = '★★★★★' | slice: 0, block.settings.rating
              assign stars_empty_count = 5 | minus: block.settings.rating
              assign stars_empty = '★★★★★' | slice: 0, stars_empty_count
            -%}
            <span
              class="product-reviews__stars"
              role="img"
              aria-label="{{ 'reviews.stars_label' | t: rating: block.settings.rating }}"
            >
              {{- stars_filled -}}
              <span class="product-reviews__stars-empty" aria-hidden="true">{{ stars_empty }}</span>
            </span>

            {%- if block.settings.title != blank -%}
              <h3 class="review-dialog__title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- liquid
              assign image_index = 0
              for i in (1..3)
                assign image_key = 'image_' | append: i
                assign review_image = block.settings[image_key]
                if review_image == blank
                  continue
                endif
                if image_index == 0
                  echo '<div class="review-dialog__thumbs">'
                endif
                echo '<button type="button" class="review-dialog__thumb" data-goto="' | append: image_index | append: '">'
                echo review_image | image_url: width: 160 | image_tag: class: 'review-dialog__thumb-image', loading: 'lazy', alt: ''
                echo '</button>'
                assign image_index = image_index | plus: 1
              endfor
              if image_index > 0
                echo '</div>'
              endif
            -%}

            {%- if block.settings.text != blank -%}
              <p class="review-dialog__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      </dialog>
    {%- endif -%}
  {%- endfor -%}
</product-reviews>

{% stylesheet %}
  .product-reviews {
    display: block;
    grid-column: 1 / -1;
    /* Anchor target for the PDP header's rating link — land clear of the
       sticky header (body's --header-height, kept live by header.js). */
    scroll-margin-block-start: calc(var(--header-height, 60px) + 12px);

    /* Same inset formula as the ingredient cards section, so all the PDP
       storytelling sections' content edges line up at every viewport width */
    --product-reviews-inset: max(3rem, calc((100vw - var(--page-width, 1300px)) / 2 + 3rem));
  }

  .product-reviews__inner {
    padding-inline: var(--product-reviews-inset);
  }

  .product-reviews__heading {
    margin: 0 0 2rem;
    font-size: clamp(2.25rem, 3.6vw, 3.25rem);
    line-height: 1.08;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  /* Summary strip: average | histogram | CTA */
  .product-reviews__summary {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-block: 1.5rem 2.5rem;

    @media screen and (min-width: 990px) {
      grid-template-columns: auto minmax(0, 420px) auto;
      justify-content: space-between;
      gap: 4rem;
    }
  }

  .product-reviews__average {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .product-reviews__average-value {
    font-family: var(--font-heading--family);
    font-size: 3rem;
    line-height: 1;
  }

  .product-reviews__average-meta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .product-reviews__based-on {
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .product-reviews__stars {
    font-size: 1rem;
    letter-spacing: 0.15em;
    color: var(--pdp-accent, var(--color-foreground));
  }

  .product-reviews__stars-empty {
    opacity: 0.25;
  }

  /* Fractional average: dim track with a clipped filled overlay */
  .product-reviews__stars--average {
    position: relative;
    display: inline-block;
    line-height: 1;
  }

  .product-reviews__stars-track {
    opacity: 0.25;
  }

  .product-reviews__stars-fill {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .product-reviews__histogram {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-reviews__histogram-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 3rem;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .product-reviews__histogram-star {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .product-reviews__histogram-star span {
    color: var(--pdp-accent, var(--color-foreground));
  }

  .product-reviews__histogram-bar {
    display: block;
    height: 8px;
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / 0.1);
    overflow: hidden;
  }

  .product-reviews__histogram-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background-color: var(--color-foreground);
  }

  .product-reviews__histogram-count {
    text-align: end;
    font-variant-numeric: tabular-nums;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  /* Media rail */
  .product-reviews__media {
    padding-block: 1.5rem 0.5rem;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .product-reviews__media-heading {
    margin: 0 0 1rem;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .product-reviews__media-slideshow slideshow-slides {
    gap: 0.75rem;
  }

  .product-reviews__media-slideshow slideshow-slide {
    width: 11rem;
    scroll-snap-align: start;
  }

  .product-reviews__media-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 6 / 5;
    padding: 0;
    border: 0;
    border-radius: 10px;
    overflow: hidden;
    background: none;
    cursor: pointer;
  }

  /* Live rail built by product-reviews.js from the Klaviyo client API */
  .product-reviews__media-rail {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-block-end: 0.5rem;
  }

  .product-reviews__media-rail::-webkit-scrollbar {
    display: none;
  }

  .product-reviews__media-rail[hidden] {
    display: none;
  }

  .product-reviews__media-rail .product-reviews__media-thumb {
    flex: 0 0 11rem;
    scroll-snap-align: start;
  }

  .product-reviews__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Review list */
  .product-reviews__list {
    display: flex;
    flex-direction: column;
  }

  .product-reviews__review {
    display: grid;
    gap: 0.75rem 2rem;
    padding-block: 1.75rem;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.12);

    @media screen and (min-width: 750px) {
      grid-template-columns: 13rem minmax(0, 1fr) auto;
      align-items: start;
    }
  }

  .product-reviews__reviewer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .product-reviews__avatar,
  .review-dialog__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: rgb(var(--color-foreground-rgb) / 0.08);
    font-family: var(--font-subheading--family);
    font-size: 0.9375rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-reviews__reviewer-meta,
  .review-dialog__reviewer {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .product-reviews__author,
  .review-dialog__author {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .product-reviews__verified,
  .review-dialog__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .product-reviews__verified-check,
  .review-dialog__verified-check {
    display: inline-flex;
    width: 0.875rem;
  }

  .product-reviews__verified-check svg,
  .review-dialog__verified-check svg {
    width: 100%;
    height: auto;
  }

  .product-reviews__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .product-reviews__review-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.375rem 0.75rem;
  }

  .product-reviews__review-title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 600;
  }

  .product-reviews__review-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  /* Which product a review belongs to, shown in combined (all-products) mode */
  .product-reviews__review-product,
  .review-dialog__product {
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .product-reviews__review-thumbs {
    display: flex;
    gap: 0.5rem;
  }

  .product-reviews__review-thumb {
    display: block;
    width: 4rem;
    height: 4rem;
    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 8px;
    overflow: hidden;
    background: none;
    cursor: pointer;
  }

  .product-reviews__review-thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-reviews__date {
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  /* The row's grid display would otherwise override the hidden attribute */
  .product-reviews__review[hidden] {
    display: none;
  }

  .product-reviews__app-widget {
    padding-block: 1.5rem;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .product-reviews__app-widget:empty {
    display: none;
  }

  .product-reviews__show-more {
    display: flex;
    justify-content: center;
    padding-block-start: 1.75rem;
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .product-reviews__show-more[hidden] {
    display: none;
  }

  /* Dialog */
  .review-dialog {
    width: min(60rem, calc(100vw - 2rem));
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 20px;
    /* White card even when the section sits on the sand background */
    background-color: var(--pdp-surface, var(--color-background));
    color: var(--color-foreground);
    overflow: hidden;
  }

  .review-dialog:not([open]) {
    display: none;
  }

  .review-dialog::backdrop {
    background-color: rgb(252 251 249 / 0.82);
  }

  .review-dialog__layout {
    display: grid;
    max-height: min(85dvh, 44rem);

    @media screen and (min-width: 750px) {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .review-dialog__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    background-color: rgb(var(--color-foreground-rgb) / 0.05);

    @media screen and (max-width: 749px) {
      aspect-ratio: 4 / 3;
    }
  }

  .review-dialog__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .review-dialog__close,
  .review-dialog__nav {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 50%;
    padding: 0;
    background-color: #fff;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .review-dialog__close:hover,
  .review-dialog__nav:hover {
    background-color: #f2efeb;
  }

  .review-dialog__close {
    top: 16px;
    inset-inline-end: 16px;
  }

  .review-dialog__close svg {
    width: 14px;
    height: 14px;
  }

  .review-dialog__nav {
    top: 50%;
    translate: 0 -50%;
  }

  .review-dialog__nav svg {
    width: 12px;
    height: 12px;
  }

  .review-dialog__nav--prev {
    inset-inline-start: 12px;
  }

  /* The caret asset points down; rotate rather than ship two more icons */
  .review-dialog__nav--prev svg {
    rotate: 90deg;
  }

  .review-dialog__nav--next {
    inset-inline-end: 12px;
  }

  .review-dialog__nav--next svg {
    rotate: -90deg;
  }

  .review-dialog__nav[hidden] {
    display: none;
  }

  .review-dialog__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 2rem;
    overflow-y: auto;
  }

  .review-dialog__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .review-dialog__date {
    margin-inline-start: auto;
    font-size: 0.8125rem;
    color: rgb(var(--color-foreground-rgb) / 0.6);
  }

  .review-dialog__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .review-dialog__thumbs {
    display: flex;
    gap: 0.5rem;
  }

  .review-dialog__thumb {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 8px;
    overflow: hidden;
    background: none;
    cursor: pointer;
  }

  .review-dialog__thumb[aria-current='true'] {
    border-color: var(--color-foreground);
  }

  .review-dialog__thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-dialog__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media screen and (max-width: 749px) {
    .product-reviews {
      --product-reviews-inset: 1.5rem;
    }

    .product-reviews.spacing-style {
      padding-block: 2.5rem 3rem;
    }

    .product-reviews__heading {
      font-size: 1.875rem;
      margin-block-end: 1.25rem;
    }

    .product-reviews__summary {
      padding-block: 0.5rem 1.75rem;
    }

    .product-reviews__date {
      order: -1;
    }

    .review-dialog__layout {
      max-height: 85dvh;
      overflow-y: auto;
      display: block;
    }

    .review-dialog__content {
      padding: 1.5rem;
    }
  }
{% endstylesheet %}

