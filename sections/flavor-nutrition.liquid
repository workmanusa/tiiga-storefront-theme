{% comment %}
  Flavor & nutrition section for the PDP. Renders one _flavor-nutrition-panel
  block per flavor (photo, story, allergen lines, nutrition facts card) and
  shows only the panel matching the selected variant's Flavor option value.
  assets/flavor-nutrition.js swaps panels when the shopper changes flavor.

  The benefit icons and certification logos are shared by every flavor, so
  they live here in the section settings and the panel blocks read them via
  section.settings.
{% endcomment %}

<flavor-nutrition-panels class="flavor-nutrition">
  {% content_for 'blocks' %}
</flavor-nutrition-panels>

<script src="{{ 'flavor-nutrition.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  flavor-nutrition-panels {
    display: block;
  }
{% endstylesheet %}

{% schema %}
