{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="subscribe-products spacing-style section section--full-width color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --shop-card-background: {{ section.settings.card_background | default: '#f8f2ee' }};"
>
  <header class="subscribe-products__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="subscribe-products__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="subscribe-products__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="subscribe-products__text">{{ section.settings.text }}</div>
    {%- endif -%}
  </header>

  <div class="subscribe-products__rail">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .subscribe-products {
    grid-column: 1 / -1;
  }

  .subscribe-products__header {
    display: grid;
    justify-items: start;
    text-align: start;
    padding-inline: var(--util-page-margin-offset);
    margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
  }

  .subscribe-products__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .subscribe-products__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(2rem, 3.2vw, 2.875rem);
    line-height: 1.1;
  }

  .subscribe-products__text {
    margin-block-start: 0.875rem;
    max-width: 34rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  .subscribe-products__text p {
    margin: 0;
  }

  /* Same full-bleed rail as the /collections rows: cards scroll to the
     viewport edge, no visible scrollbar. */
  .subscribe-products__rail {
    display: flex;
    gap: var(--gap-md);
    overflow-x: auto;
    padding-inline: var(--util-page-margin-offset);
    scroll-padding-inline-start: var(--util-page-margin-offset);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .subscribe-products__rail::-webkit-scrollbar {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.subscribe_products",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:settings.card_background",
      "default": "#f8f2ee"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "_subscribe-product"
    }
  ],
  "presets": [
    {
      "name": "t:names.subscribe_products",
      "category": "t:categories.products",
      "blocks": {
        "card_1": { "type": "_subscribe-product" },
        "card_2": { "type": "_subscribe-product" },
        "card_3": { "type": "_subscribe-product" }
      },
      "block_order": ["card_1", "card_2", "card_3"]
    }
  ]
}
{% endschema %}
