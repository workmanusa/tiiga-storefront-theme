{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="timeline spacing-style section section--page-width color-custom-{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %};
    --timeline-accent: {{ section.settings.accent_color }};
    --timeline-rail-inset: 2rem;
    --timeline-surface: {{ section.settings.background_color | default: '#f6f4f0' }};
  "
>
  <div class="timeline__inner">
    <div class="timeline__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="timeline__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="timeline__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="timeline__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <ol class="timeline__list">
      {% content_for 'blocks' %}
    </ol>
  </div>
</div>

{% stylesheet %}
  .timeline__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
    align-items: start;
    gap: 3.5rem;
  }

  .timeline__header {
    position: sticky;
    /* Holds the heading beside the rail while the milestones scroll past */
    inset-block-start: 6rem;
  }

  .timeline__eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--timeline-accent);
  }

  .timeline__heading {
    margin: 0;
  }

  .timeline__text {
    margin-block-start: 1rem;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .timeline__text > :first-child {
    margin-block-start: 0;
  }

  .timeline__text > :last-child {
    margin-block-end: 0;
  }

  .timeline__list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The rail: one line behind every dot, stopping at the last one */
  .timeline__list::before {
    content: '';
    position: absolute;
    inset-block: 0.75em 2.25rem;
    inset-inline-start: var(--timeline-rail-inset);
    width: 1px;
    background-color: rgb(var(--color-foreground-rgb) / 0.18);
  }

  @media screen and (max-width: 989px) {
    .timeline__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .timeline__header {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    .timeline {
      --timeline-rail-inset: 1.5rem;
    }

    .timeline__list::before {
      inset-block-end: 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.milestone_timeline",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.accent_color",
      "default": "#1d5a6b"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "_milestone"
    }
  ],
  "presets": [
    {
      "name": "t:names.milestone_timeline",
      "category": "t:categories.storytelling",
      "blocks": {
        "milestone_1": { "type": "_milestone" },
        "milestone_2": { "type": "_milestone" },
        "milestone_3": { "type": "_milestone" }
      },
      "block_order": ["milestone_1", "milestone_2", "milestone_3"]
    }
  ]
}
{% endschema %}
