{%- liquid
  assign hero_media_modifier = ''
  if section.settings.image_1 == blank or section.settings.image_2 == blank
    assign hero_media_modifier = ' landing-hero__media--single'
  endif
-%}

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: section.settings.text_color,
  section_id: section.id
%}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="landing-hero landing-hero--{{ section.settings.layout }} spacing-style section section--full-width color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="landing-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="landing-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="landing-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="landing-hero__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.image_1 != blank or section.settings.image_2 != blank -%}
      <div class="landing-hero__media{{ hero_media_modifier }} landing-hero__media--fit-{{ section.settings.media_fit | default: 'cover' }}">
        {%- if section.settings.image_1 != blank -%}
          {{
            section.settings.image_1
            | image_url: width: 900
            | image_tag:
              widths: '300, 480, 640, 900',
              sizes: '(min-width: 990px) 680px, (min-width: 750px) 48vw, 90vw',
              class: 'landing-hero__image landing-hero__image--lead',
              fetchpriority: 'high'
          }}
        {%- endif -%}
        {%- if section.settings.image_2 != blank -%}
          {{
            section.settings.image_2
            | image_url: width: 900
            | image_tag:
              widths: '300, 480, 640, 900',
              sizes: '(min-width: 750px) 300px, 42vw',
              class: 'landing-hero__image landing-hero__image--trail',
              loading: 'lazy'
          }}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank -%}
      <div class="landing-hero__actions">
        {%- if section.settings.primary_button_label != blank -%}
          <a
            class="button landing-hero__button"
            href="{{ section.settings.primary_button_link | default: '#' }}"
          >
            {{- section.settings.primary_button_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a
            class="button-secondary landing-hero__button landing-hero__button--secondary"
            href="{{ section.settings.secondary_button_link | default: '#' }}"
          >
            {{- section.settings.secondary_button_label -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.rating != blank or section.settings.review_count != blank or section.settings.shipping_note != blank -%}
      <div class="landing-hero__proof">
        {%- if section.settings.rating != blank -%}
          <span class="landing-hero__rating">
            <span
              class="landing-hero__stars"
              role="img"
              aria-label="{{ 'reviews.stars_label' | t: rating: section.settings.rating }}"
            >
              ★★★★★
            </span>
            <span class="landing-hero__rating-value">{{ section.settings.rating }}</span>
          </span>
        {%- endif -%}
        {%- if section.settings.review_count != blank -%}
          <span class="landing-hero__proof-item">{{ section.settings.review_count }}</span>
        {%- endif -%}
        {%- if section.settings.shipping_note != blank -%}
          <span class="landing-hero__proof-item">{{ section.settings.shipping_note }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
      <div class="landing-hero__disclaimer">{{ section.settings.disclaimer }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .landing-hero {
    grid-column: 1 / -1;
  }

  .landing-hero__inner {
    display: grid;
    justify-items: center;
    max-width: 46rem;
    margin-inline: auto;
    padding-inline: max(var(--page-margin, 2rem), 1.5rem);
    text-align: center;
    grid-template-areas:
      'eyebrow'
      'heading'
      'text'
      'media'
      'actions'
      'proof'
      'disclaimer';
  }

  .landing-hero__eyebrow {
    grid-area: eyebrow;
    margin: 0 0 1.5rem;
    padding: 0.5rem 1.125rem;
    border-radius: 999px;
    background-color: rgb(var(--color-foreground-rgb) / 0.16);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .landing-hero__heading {
    grid-area: heading;
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .landing-hero__text {
    grid-area: text;
    margin-block-start: 1.25rem;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.85);
  }

  .landing-hero__text p {
    margin: 0;
  }

  .landing-hero__media {
    grid-area: media;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-block-start: 2.5rem;
  }

  .landing-hero__image {
    display: block;
    width: min(42vw, 300px);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 12px;
  }

  .landing-hero__image--lead {
    rotate: -4deg;
  }

  .landing-hero__image--trail {
    rotate: 4deg;
  }

  /* Show the whole frame: the box takes the image's own ratio, so nothing is
     cropped and no letterbox bars appear either. */
  .landing-hero__media--fit-contain .landing-hero__image {
    aspect-ratio: auto;
    object-fit: contain;
  }

  .landing-hero__media--single .landing-hero__image {
    width: min(80vw, 22.5rem);
    rotate: none;
  }

  .landing-hero__actions {
    grid-area: actions;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(100%, 26rem);
    margin-block-start: 2.5rem;
  }

  .landing-hero__button {
    justify-content: center;
    width: 100%;
  }

  .landing-hero__button--secondary {
    background-color: transparent;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.45);
    color: var(--color-foreground);
  }

  .landing-hero__button--secondary:hover {
    background-color: rgb(var(--color-foreground-rgb) / 0.1);
    border-color: currentcolor;
  }

  .landing-hero__proof {
    grid-area: proof;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-block-start: 1.5rem;
    font-size: 0.875rem;
  }

  .landing-hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .landing-hero__stars {
    letter-spacing: 0.1em;
    color: #f5a623;
  }

  .landing-hero__rating-value {
    font-weight: 600;
  }

  .landing-hero__proof-item {
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .landing-hero__disclaimer {
    grid-area: disclaimer;
    margin-block-start: 1.5rem;
    max-width: 34rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .landing-hero__disclaimer p {
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .landing-hero--split .landing-hero__inner {
      max-width: var(--page-width, 1300px);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 4rem;
      align-items: center;
      justify-items: start;
      text-align: start;
      grid-template-areas:
        'eyebrow    media'
        'heading    media'
        'text       media'
        'actions    media'
        'proof      media'
        'disclaimer media';
    }

    .landing-hero--split .landing-hero__heading {
      font-size: clamp(2.5rem, 3.6vw, 3.5rem);
    }

    .landing-hero--split .landing-hero__media {
      width: 100%;
      margin-block-start: 0;
    }

    .landing-hero--split .landing-hero__image {
      width: 100%;
    }

    .landing-hero--split .landing-hero__media--single .landing-hero__image {
      width: min(100%, 26.25rem);
    }

    /* Nothing is cropped in contain mode, so the image can use the whole
       column rather than the narrower cap a cropped portrait needs. */
    .landing-hero--split .landing-hero__media--fit-contain .landing-hero__image {
      width: 100%;
    }

    .landing-hero--split .landing-hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
      gap: 1rem;
    }

    .landing-hero--split .landing-hero__button {
      width: auto;
      min-width: 15rem;
    }

    .landing-hero--split .landing-hero__proof,
    .landing-hero--split .landing-hero__actions {
      justify-content: flex-start;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .landing-hero__image {
      transition: rotate 0.3s ease;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.landing_hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        { "value": "centered", "label": "t:options.centered" },
        { "value": "split", "label": "t:options.split" }
      ],
      "default": "centered"
    },
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "t:settings.media_fit",
      "options": [
        { "value": "cover", "label": "t:options.cover" },
        { "value": "contain", "label": "t:options.contain" }
      ],
      "default": "cover"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "t:settings.image_1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:settings.image_2"
    },
    {
      "type": "header",
      "content": "t:content.buttons"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "t:settings.primary_button_label"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "t:settings.primary_button_link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:settings.secondary_button_label"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:settings.secondary_button_link"
    },
    {
      "type": "header",
      "content": "t:content.social_proof"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "t:settings.rating"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "t:settings.review_count"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "t:settings.shipping_note"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "t:settings.disclaimer"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:names.landing_hero",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
