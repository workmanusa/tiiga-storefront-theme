{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="science-spec spacing-style section section--full-width color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="science-spec__grid">
    <div class="science-spec__media">
      {%- if section.settings.image -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            widths: '480, 720, 960, 1200',
            sizes: '(min-width: 990px) 560px, 100vw',
            class: 'science-spec__image',
            loading: 'lazy'
        }}
      {%- else -%}
        <img
          src="{{ 'science-placeholder.jpg' | asset_url }}"
          alt=""
          class="science-spec__image"
          loading="lazy"
          width="900"
          height="600"
        >
      {%- endif -%}
      {%- if section.settings.badge_title != blank -%}
        <div class="science-spec__badge">
          {%- if section.settings.badge_label != blank -%}
            <span class="science-spec__badge-label">{{ section.settings.badge_label }}</span>
          {%- endif -%}
          <span class="science-spec__badge-title">{{ section.settings.badge_title }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="science-spec__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="science-spec__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="science-spec__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="science-spec__rows">
        {% content_for 'blocks' %}
      </div>

      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="science-spec__link" href="{{ section.settings.link }}">
          {{- section.settings.link_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .science-spec {
    grid-column: 1 / -1;
  }

  .science-spec__grid {
    display: grid;
    gap: 2rem;
    max-width: var(--page-width, 1300px);
    margin-inline: auto;
    padding-inline: max(var(--page-margin, 2rem), 3rem);

    @media screen and (min-width: 990px) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .science-spec__media {
    position: relative;
  }

  .science-spec__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 16px;
  }

  .science-spec__badge {
    position: absolute;
    inset-inline-start: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    background-color: var(--color-white, #fff);
    color: #33302c;
    border-radius: 10px;
    padding: 0.75rem 1.125rem;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
  }

  .science-spec__badge-label {
    font-family: var(--font-subheading--family);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 0.55);
  }

  .science-spec__badge-title {
    font-size: 1rem;
    font-weight: 600;
  }

  .science-spec__heading {
    margin: 0 0 1.25rem;
    max-width: 16ch;
    font-size: clamp(1.75rem, 2.9vw, 2.75rem);
    line-height: 1.15;
  }

  .science-spec__text {
    max-width: 34rem;
    margin-block-end: 2rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .science-spec__text p {
    margin: 0;
  }

  .science-spec__link {
    display: inline-block;
    margin-block-start: 1.5rem;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: currentcolor;
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  @media screen and (max-width: 749px) {
    .science-spec__grid {
      padding-inline: 1.5rem;
    }

    .science-spec__image {
      aspect-ratio: 4 / 4.4;
    }

    .science-spec__heading {
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.science_spec",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "t:settings.label"
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "t:settings.title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "_science-row"
    }
  ],
  "presets": [
    {
      "name": "t:names.science_spec",
      "category": "t:categories.storytelling",
      "blocks": {
        "row_1": { "type": "_science-row" },
        "row_2": { "type": "_science-row" },
        "row_3": { "type": "_science-row" }
      },
      "block_order": ["row_1", "row_2", "row_3"]
    }
  ]
}
{% endschema %}
