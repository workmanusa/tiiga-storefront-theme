{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<div
  class="story-rows story-rows--media-{{ section.settings.media_width }} spacing-style section section--full-width color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="story-rows__inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="story-rows__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="story-rows__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="story-rows__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="story-rows__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="story-rows__list" role="list">
      {% content_for 'blocks' %}
    </ol>
  </div>
</div>

{% stylesheet %}
  .story-rows {
    grid-column: 1 / -1;
  }

  .story-rows__inner {
    width: 100%;
    max-width: var(--page-width, 1300px);
    margin-inline: auto;
    padding-inline: max(var(--page-margin, 2rem), 3rem);
  }

  .story-rows__header {
    max-width: 42rem;
    margin-block-end: 2.5rem;
  }

  .story-rows__eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-subheading--family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .story-rows__heading {
    margin: 0;
    font-size: clamp(1.75rem, 2.9vw, 2.75rem);
    line-height: 1.15;
  }

  .story-rows__text {
    margin-block-start: 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .story-rows__text p {
    margin: 0;
  }

  .story-rows__list {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Full-width media reads as a single editorial column, so the cards are
     narrowed instead of stretching a text measure across the whole section. */
  .story-rows--media-full .story-rows__list {
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
  }

  @media screen and (max-width: 749px) {
    .story-rows__inner {
      padding-inline: 1.5rem;
    }

    .story-rows__list {
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.story_rows",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "t:settings.media_width",
      "options": [
        { "value": "beside", "label": "t:options.beside" },
        { "value": "full", "label": "t:options.full" }
      ],
      "default": "beside"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "_story-row"
    }
  ],
  "presets": [
    {
      "name": "t:names.story_rows",
      "category": "t:categories.storytelling",
      "blocks": {
        "row_1": { "type": "_story-row" },
        "row_2": { "type": "_story-row" },
        "row_3": { "type": "_story-row" }
      },
      "block_order": ["row_1", "row_2", "row_3"]
    }
  ]
}
{% endschema %}
